<Screen Name="EditorScreen" StyleSheet="Editor/Styles/editor.css" class="editor">
  <ProcessConnection Name="Runtime">
    <ProcessConnection.Arguments>
      <ProcessArgument Value="-server=true"/>
      <ProcessArgument Value="apps/Example"/>
    </ProcessConnection.Arguments>
  </ProcessConnection>
  <!-- Every 1px gap reveals editor-frame, so panels, menu and status bar share
       one continuous hairline grid instead of exposing the window clear colour. -->
  <Grid Name="EditorRoot" Rows="28px 1fr 22px" Columns="1fr" Spacing="1" class="editor-frame">
    <Grid Name="MenuSlot" Rows="1fr" Columns="1fr"/>
    <Grid Rows="1fr" Columns="260px 1fr 416px" Spacing="1">
      <Grid Name="LeftPanels" Rows="1fr 1fr" Columns="1fr" Spacing="1">
        <Grid Name="HierarchySlot" Rows="1fr" Columns="1fr"/>
        <Grid Name="ProjectSlot" Rows="1fr" Columns="1fr"/>
      </Grid>
      <Grid Name="CenterPanels" Rows="1fr 190px" Columns="1fr" Spacing="1">
        <Grid Name="PreviewSlot" Rows="1fr" Columns="1fr"/>
        <Grid Name="ConsoleSlot" Rows="1fr" Columns="1fr"/>
      </Grid>
      <Grid Name="InspectorSlot" Rows="1fr" Columns="1fr"/>
    </Grid>
    <Grid Name="StatusSlot" Rows="1fr" Columns="1fr"/>
  </Grid>
  <Node2D Name="Overlay" Visible="false"/>
</Screen>
