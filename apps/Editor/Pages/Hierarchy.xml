<Grid Name="HierarchyPanel" Rows="36px 1fr auto" Columns="1fr" class="editor-panel" Controller="Editor/Scripts/DataPanel" KeyDown="Key">
  <XmlDataSource Name="Source" ConnectionPath="Runtime" Schema="Editor/Data/Editor.Schema.xml" AutoLoad="false"/>
  <Grid Columns="1fr 32px 32px" Spacing="4" Padding="6 2">
    <Input Name="Search" PlaceholderText="Find node or class" Submit="Search" class="editor-input"/>
    <Button Text="×" Click="ClearSearch" class="toolbar-button"/>
    <Button Text="+" Click="Create" class="toolbar-button"/>
  </Grid>
  <ListBox Name="Items" ItemsSource="{Binding ../Source/Items}" ItemTemplate="Editor/Templates/SceneNodeRow"
           ItemNamePrefix="SceneNode" ValueProperty="Path" SelectionChanged="Select" OverflowY="Scroll" class="editor-list"/>
  <TextBlock Name="DataSourceError" Text="{Binding ../Source/ErrorMessage}" Visible="{Binding ../Source/HasError}" class="editor-error" Padding="8" TextWrapping="Wrap"/>
</Grid>
