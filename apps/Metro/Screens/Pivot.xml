<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Screen SYSTEM "https://corepunch.github.io/orca/schemas/orca.dtd">
<Screen Name="PivotDemo" Width="390" Height="844" ResizeMode="NoResize" ClearColor="#000000" StyleSheet="Metro/Screens/metro.css">
	<Grid Rows="1fr 58px" Foreground="#FFFFFF">
		<Pivot Name="Pivot" Title="Messenger">
			<PivotItem Name="Recent" Header="recent">
				<StackView Spacing="22">
					<StackView Spacing="2"><TextBlock class="item">alex morgan</TextBlock><TextBlock class="detail">See you at the little coffee place?</TextBlock></StackView>
					<StackView Spacing="2"><TextBlock class="item">weekend people</TextBlock><TextBlock class="detail">Maya: That sounds like a plan</TextBlock></StackView>
					<StackView Spacing="2"><TextBlock class="item">jules park</TextBlock><TextBlock class="detail">The photos turned out so good</TextBlock></StackView>
				</StackView>
			</PivotItem>
			<PivotItem Name="Online" Header="online">
				<StackView Spacing="22">
					<TextBlock class="item">maya chen</TextBlock>
					<TextBlock class="item">jules park</TextBlock>
				</StackView>
			</PivotItem>
			<PivotItem Name="Groups" Header="groups">
				<TextBlock class="item">weekend people</TextBlock>
			</PivotItem>
		</Pivot>
		<ApplicationBar Name="AppBar">
			<ApplicationBarIconButton Name="New" IconUri="Metro/Icons/plus.svg" Text="new"/>
			<ApplicationBarIconButton Name="Search" IconUri="Metro/Icons/search.svg" Text="search"/>
			<ApplicationBarIconButton Name="Refresh" IconUri="Metro/Icons/refresh-cw.svg" Text="refresh"/>
			<ApplicationBarMenuItem Name="Settings" Text="settings"/>
			<ApplicationBarMenuItem Name="About" Text="about"/>
		</ApplicationBar>
	</Grid>
</Screen>
