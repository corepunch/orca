<!-- A person in search results and suggestions, bound to an OctopusProfile.
     The photo and the name-and-bio stack both centre in the 56-point target,
     so a one-line bio sits level with the photo. -->
<Button Height="56" Click="OpenPerson" BackgroundColor="#00000000" class="octopus-row">
  <Grid Name="PersonRow" Columns="44px 1fr" Spacing="8" IgnoreHitTest="true">
    <Grid Width="44" Height="44" MarginTop="auto" MarginBottom="auto" StateClasses="{Binding DataContext/Tone, Mode=OneTime}" IgnoreHitTest="true">
      <TextBlock Text="{Binding DataContext/Initials, Mode=OneTime}" FontSize="19" class="avatar-initials"
                 TextHorizontalAlignment="Center" TextVerticalAlignment="Center" IgnoreHitTest="true"/>
      <ImageView Name="AvatarPhoto" Visible="{Binding DataContext/HasAvatar, Mode=OneTime}" Src="{Binding DataContext/AvatarPath, Mode=OneTime}"
                 ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
    </Grid>
    <StackView Name="PersonText" Spacing="2" JustifyContent="Center" IgnoreHitTest="true">
      <TextBlock Name="PersonName" Text="{Binding DataContext/Title, Mode=OneTime}" FontSize="20" TextOverflow="Ellipsis" TextWrapping="NoWrap"
                 class="octopus-ink" IgnoreHitTest="true"/>
      <TextBlock Name="PersonBio" Visible="{Binding DataContext/HasBio, Mode=OneTime}" Text="{Binding DataContext/BioExcerpt, Mode=OneTime}" FontSize="13"
                 TextOverflow="Ellipsis" TextWrapping="NoWrap" class="octopus-dim" IgnoreHitTest="true"/>
    </StackView>
  </Grid>
</Button>
