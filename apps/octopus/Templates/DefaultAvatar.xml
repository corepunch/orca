<Grid>
  <Button Name="SelectAvatar" Click="ChangePhoto" Padding="6" class="octopus-action octopus-outline" BorderWidth="2">
    <StackView Spacing="6" JustifyContent="Start" IgnoreHitTest="true">
      <ImageView Name="AvatarPortrait" Src="{Binding DataContext/Path}" AspectRatio="1" Stretch="UniformToFill" ForegroundColor="#ffffff" IgnoreHitTest="true"/>
      <TextBlock Name="AvatarLabel" Text="{Binding DataContext/Label}" FontSize="13" TextHorizontalAlignment="Center" WordWrap="true"
                 class="octopus-ink" IgnoreHitTest="true"/>
    </StackView>
  </Button>
</Grid>
