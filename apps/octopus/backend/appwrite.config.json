{
  "projectId": "69f1c06800389dc6a1a0",
  "projectName": "Octopus",
  "endpoint": "https://fra.cloud.appwrite.io/v1",
  "functions": [{
    "$id": "octopus-feed",
    "name": "Octopus public feed materializer",
    "runtime": "node-22",
    "path": ".",
    "entrypoint": "src/main.js",
    "commands": "npm install --omit=dev --ignore-scripts",
    "execute": [],
    "events": [
      "databases.octopus-db.collections.posts.update",
      "databases.octopus-db.collections.likes.update",
      "databases.octopus-db.collections.comments.update",
      "databases.octopus-db.collections.reposts.update",
      "databases.octopus-db.collections.profiles.update",
      "databases.octopus-db.collections.posts.documents.*.create",
      "databases.octopus-db.collections.posts.documents.*.update",
      "databases.octopus-db.collections.posts.documents.*.upsert",
      "databases.octopus-db.collections.posts.documents.*.delete",
      "databases.octopus-db.collections.likes.documents.*.create",
      "databases.octopus-db.collections.likes.documents.*.update",
      "databases.octopus-db.collections.likes.documents.*.upsert",
      "databases.octopus-db.collections.likes.documents.*.delete",
      "databases.octopus-db.collections.comments.documents.*.create",
      "databases.octopus-db.collections.comments.documents.*.update",
      "databases.octopus-db.collections.comments.documents.*.upsert",
      "databases.octopus-db.collections.comments.documents.*.delete",
      "databases.octopus-db.collections.reposts.documents.*.create",
      "databases.octopus-db.collections.reposts.documents.*.update",
      "databases.octopus-db.collections.reposts.documents.*.upsert",
      "databases.octopus-db.collections.reposts.documents.*.delete",
      "databases.octopus-db.collections.profiles.documents.*.create",
      "databases.octopus-db.collections.profiles.documents.*.update",
      "databases.octopus-db.collections.profiles.documents.*.upsert",
      "databases.octopus-db.collections.profiles.documents.*.delete",
      "tablesdb.octopus-db.tables.posts.update",
      "tablesdb.octopus-db.tables.likes.update",
      "tablesdb.octopus-db.tables.comments.update",
      "tablesdb.octopus-db.tables.reposts.update",
      "tablesdb.octopus-db.tables.profiles.update",
      "tablesdb.octopus-db.tables.posts.rows.*.create",
      "tablesdb.octopus-db.tables.posts.rows.*.update",
      "tablesdb.octopus-db.tables.posts.rows.*.upsert",
      "tablesdb.octopus-db.tables.posts.rows.*.delete",
      "tablesdb.octopus-db.tables.likes.rows.*.create",
      "tablesdb.octopus-db.tables.likes.rows.*.update",
      "tablesdb.octopus-db.tables.likes.rows.*.upsert",
      "tablesdb.octopus-db.tables.likes.rows.*.delete",
      "tablesdb.octopus-db.tables.comments.rows.*.create",
      "tablesdb.octopus-db.tables.comments.rows.*.update",
      "tablesdb.octopus-db.tables.comments.rows.*.upsert",
      "tablesdb.octopus-db.tables.comments.rows.*.delete",
      "tablesdb.octopus-db.tables.reposts.rows.*.create",
      "tablesdb.octopus-db.tables.reposts.rows.*.update",
      "tablesdb.octopus-db.tables.reposts.rows.*.upsert",
      "tablesdb.octopus-db.tables.reposts.rows.*.delete",
      "tablesdb.octopus-db.tables.profiles.rows.*.create",
      "tablesdb.octopus-db.tables.profiles.rows.*.update",
      "tablesdb.octopus-db.tables.profiles.rows.*.upsert",
      "tablesdb.octopus-db.tables.profiles.rows.*.delete"
    ],
    "schedule": "",
    "interval": 60,
    "timeout": 600,
    "enabled": true,
    "logging": true,
    "ignore": "node_modules\n.git\n.env\n.env.*\ntest\n*.tar.gz",
    "scopes": ["collections.read", "documents.read", "documents.write"]
  }]
}
