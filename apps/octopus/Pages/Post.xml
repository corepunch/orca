<!-- A post page over the Post scope (Data/Post.xml). PostDetail presents the
     exposed Post record (its bindings read the post's fields and its actions
     receive the post); comments and the comment bar bind to the scope. -->
<Node2D Name="PostRoot">
  <StackView Name="PostPage" PaddingTop="20" Spacing="16" Overflow="hidden scroll" JustifyContent="Start">
    <StackView Name="PostDetail" Spacing="16" JustifyContent="Start" class="post-detail">
      <Button Name="PostAuthor" Height="60" Click="OpenAuthor" BackgroundColor="#00000000" class="octopus-row">
        <Grid Columns="56px 1fr" Spacing="14" IgnoreHitTest="true">
          <Grid Width="56" Height="56" StateClasses="{Binding DataContext/Tone}" IgnoreHitTest="true">
            <TextBlock Text="{Binding DataContext/Initials}" FontSize="19" class="avatar-initials"
                       TextHorizontalAlignment="Center" TextVerticalAlignment="Center" IgnoreHitTest="true"/>
            <ImageView Name="AvatarPhoto" Visible="{Binding DataContext/HasAvatar}" Src="{Binding DataContext/AvatarPath}"
                       ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
          </Grid>
          <StackView Spacing="2" JustifyContent="Center" IgnoreHitTest="true">
            <TextBlock Name="PostAuthorName" Text="{Binding DataContext/AuthorName}" FontSize="22" TextOverflow="Ellipsis"
                       TextWrapping="NoWrap" class="octopus-ink" IgnoreHitTest="true"/>
            <TextBlock Name="PostKind" FontSize="13" class="octopus-dim" IgnoreHitTest="true">
              <BindingExpression Target="Text">{DataContext/KindLabel} + " · " + {DataContext/Age}</BindingExpression>
            </TextBlock>
          </StackView>
        </Grid>
      </Button>
      <StackView Name="PostBody" Spacing="8" IgnoreHitTest="true">
        <Grid Name="Photo" Visible="{Binding DataContext/HasPhoto}" AspectRatio="{Binding DataContext/AspectRatio}"
              class="photo-frame" StateClasses="{Binding DataContext/PhotoFrame}">
          <VectorView Source="Octopus/assets/icons/image.svg" Visible="{Binding DataContext/PhotoPending}" Width="28" Height="28"
                      MarginLeft="auto" MarginRight="auto" MarginTop="auto" MarginBottom="auto" class="octopus-dim" IgnoreHitTest="true"/>
          <ImageView Name="Image" Visible="{Binding DataContext/PhotoShown}" Src="{Binding DataContext/PhotoPath}"
                     ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
          <ActivityIndicator Name="PhotoLoading" Visible="{Binding DataContext/PhotoLoading}" class="octopus-dim"/>
          <Button Name="RetryPhoto" Visible="{Binding DataContext/PhotoFailed}" Click="Photos.Retry"
                  BackgroundColor="#00000000" class="octopus-row">
            <VectorView Name="PhotoUnavailable" Source="Octopus/assets/icons/image-off.svg" Width="28" Height="28"
                        MarginLeft="auto" MarginRight="auto" MarginTop="auto" MarginBottom="auto" class="octopus-dim" IgnoreHitTest="true"/>
          </Button>
        </Grid>
        <TextBlock Name="PostBodyCaption" Visible="{Binding DataContext/HasCaption}" Text="{Binding DataContext/Body}"
                   FontSize="15" WordWrap="true" class="octopus-ink" IgnoreHitTest="true"/>
        <Grid Visible="{Binding DataContext/IsQuote}" Columns="4px 1fr" Spacing="12" IgnoreHitTest="true">
          <Grid class="octopus-accent-fill" IgnoreHitTest="true"/>
          <StackView Spacing="4" IgnoreHitTest="true">
            <TextBlock Name="PostBodyQuote" Text="{Binding DataContext/Quote}" TrimLeading="true" WordWrap="true"
                       class="post-quote octopus-ink" IgnoreHitTest="true"/>
            <TextBlock Name="PostBodyQuoteSource" Visible="{Binding DataContext/HasQuoteSource}"
                       Text="{Binding DataContext/QuoteSourceText}" FontSize="14" WordWrap="true" class="octopus-muted" IgnoreHitTest="true"/>
          </StackView>
        </Grid>
        <TextBlock Name="PostBodyThoughts" Visible="{Binding DataContext/HasThoughts}" Text="{Binding DataContext/Thoughts}"
                   FontSize="15" WordWrap="true" class="octopus-ink" IgnoreHitTest="true"/>
        <Grid Visible="{Binding DataContext/IsLink}" Columns="44px 1fr" Spacing="8" IgnoreHitTest="true">
          <Grid Name="PostBodyLinkTile" Width="44" Height="44" class="octopus-accent-fill" IgnoreHitTest="true">
            <VectorView Source="Octopus/assets/icons/link.svg" Width="20" Height="20" MarginLeft="auto" MarginRight="auto"
                        MarginTop="auto" MarginBottom="auto" class="octopus-on-accent" IgnoreHitTest="true"/>
          </Grid>
          <StackView Spacing="4" IgnoreHitTest="true">
            <TextBlock Name="PostBodyLinkTitle" Text="{Binding DataContext/LinkTitle}" TrimLeading="true" WordWrap="true"
                       class="post-link-title octopus-accent-text" IgnoreHitTest="true"/>
            <TextBlock Name="PostBodyDomain" Text="{Binding DataContext/Domain}" FontSize="13" TextOverflow="Ellipsis"
                       TextWrapping="NoWrap" class="octopus-dim" IgnoreHitTest="true"/>
          </StackView>
        </Grid>
        <TextBlock Name="PostBodyTitle" Visible="{Binding DataContext/IsText}" Text="{Binding DataContext/Title}"
                   TrimLeading="true" WordWrap="true" class="post-title octopus-ink" IgnoreHitTest="true"/>
        <TextBlock Name="PostBodyContent" Visible="{Binding DataContext/HasContent}" Text="{Binding DataContext/Body}"
                   WordWrap="true" class="post-content" IgnoreHitTest="true"/>
      </StackView>
      <ItemsStack Name="Tags" Visible="{Binding DataContext/HasTags}" Direction="Horizontal" AlignItems="Center"
                  Spacing="8" Height="28" ItemNamePrefix="Tag" ItemsSource="{Binding DataContext/Tags}"
                  ItemTemplate="Octopus/Templates/Tag"/>
      <Button Name="CopyLink" Visible="{Binding DataContext/IsLink}" Click="CopyLink" Height="44" BorderWidth="2" FontSize="15"
              FontWeight="Bold" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
              class="octopus-action octopus-outline">Copy link</Button>
      <TextBlock Name="PostTime" Text="{Binding DataContext/Stamp}" FontSize="13" class="octopus-dim" IgnoreHitTest="true"/>
      <StackView Spacing="6" JustifyContent="Start">
        <Grid Height="1" class="octopus-rule" IgnoreHitTest="true"/>
        <Grid Name="PostStats" Columns="1fr 1fr 1fr" Height="64">
          <StackView Spacing="0" JustifyContent="Center">
            <TextBlock Name="Statlikes" Text="{Binding DataContext/LikeCount}" FontSize="28" class="octopus-ink" IgnoreHitTest="true"/>
            <TextBlock Text="{Binding DataContext/LikesLabel}" FontSize="13" class="octopus-dim" IgnoreHitTest="true"/>
          </StackView>
          <StackView Spacing="0" JustifyContent="Center">
            <TextBlock Name="Statreposts" Text="{Binding DataContext/RepostCount}" FontSize="28" class="octopus-ink" IgnoreHitTest="true"/>
            <TextBlock Text="{Binding DataContext/RepostsLabel}" FontSize="13" class="octopus-dim" IgnoreHitTest="true"/>
          </StackView>
          <StackView Spacing="0" JustifyContent="Center">
            <TextBlock Name="Statcomments" Text="{Binding DataContext/CommentCount}" FontSize="28" class="octopus-ink" IgnoreHitTest="true"/>
            <TextBlock Text="{Binding DataContext/CommentsLabel}" FontSize="13" class="octopus-dim" IgnoreHitTest="true"/>
          </StackView>
        </Grid>
        <Grid Height="1" class="octopus-rule" IgnoreHitTest="true"/>
      </StackView>
    </StackView>
    <TextBlock Text="comments" FontSize="20" MarginTop="8" class="octopus-accent-text" IgnoreHitTest="true"/>
    <StackView Name="Comments" Spacing="18" JustifyContent="Start">
      <ItemsStack Name="CommentItems" Spacing="18" JustifyContent="Start" ItemNamePrefix="Comment"
                  ItemsSource="{Binding DataContext/Comments/Items}" ItemTemplate="Octopus/Templates/Comment"/>
      <Grid Name="CommentsLoading" Visible="{Binding DataContext/Comments/IsBusy}" Height="64" IgnoreHitTest="true">
        <ActivityIndicator Name="CommentsLoadingIndicator" class="octopus-dim"/>
      </Grid>
      <StackView Name="NoComments" Visible="{Binding DataContext/Comments/ShowEmpty}" Spacing="8" Padding="0 0 24 0" JustifyContent="Start">
        <TextBlock Text="no comments yet" FontSize="22" WordWrap="true" class="octopus-muted" IgnoreHitTest="true"/>
        <TextBlock FontSize="14" WordWrap="true" class="octopus-dim" IgnoreHitTest="true">
          <BindingExpression Target="Text">IF({DataContext/Reader/IsGuest}, "Sign in to start the conversation.", "Start the conversation below.")</BindingExpression>
        </TextBlock>
      </StackView>
      <StackView Name="CommentsFailed" Visible="{Binding DataContext/Comments/ShowError}" Spacing="8" Padding="0 0 24 0" JustifyContent="Start">
        <TextBlock Text="can't load comments" FontSize="22" WordWrap="true" class="octopus-muted" IgnoreHitTest="true"/>
        <TextBlock Text="{Binding DataContext/Comments/ErrorMessage}" FontSize="14" WordWrap="true" class="octopus-dim" IgnoreHitTest="true"/>
      </StackView>
    </StackView>
  </StackView>
  <Node2D Name="CommentBar" SafeAreaEdge="Bottom" MarginLeft="-20" MarginRight="-20" Padding="20 8" class="frosted bar-top">
    <StackView Spacing="6" JustifyContent="Start">
      <TextBlock Name="PostStatus" Visible="false" FontSize="11" TextHorizontalAlignment="Center" class="octopus-dim"/>
      <Grid Name="ReplyBar" Visible="{Binding DataContext/Draft/Replying}" Columns="1fr 36px" Height="32">
        <TextBlock Name="ReplyLabel" Text="{Binding DataContext/Draft/ReplyLabel}" FontSize="13" TextVerticalAlignment="Center"
                   class="octopus-accent-text" IgnoreHitTest="true"/>
        <Button Name="CancelReply" Click="CancelReply" Width="36" Height="32" BackgroundColor="#00000000" class="octopus-row">
          <VectorView Source="Octopus/assets/icons/x.svg" Width="16" Height="16" MarginLeft="auto" MarginRight="auto"
                      MarginTop="auto" MarginBottom="auto" class="octopus-muted" IgnoreHitTest="true"/>
        </Button>
      </Grid>
      <Input Name="CommentInput" Visible="{Binding DataContext/Reader/SignedIn}" PlaceholderText="Write a comment" Height="44"
             FontSize="15" Padding="12 0" BorderWidth="2" Submit="Draft.Submit" class="octopus-input octopus-field"
             Text="{Binding DataContext/Draft/Text, Mode=TwoWay}"/>
      <Button Name="SignInToComment" Visible="{Binding DataContext/Reader/IsGuest}" Click="SignInToComment" Height="40"
              FontSize="15" TextHorizontalAlignment="Left" TextVerticalAlignment="Center"
              class="octopus-action octopus-link">Sign in to comment</Button>
    </StackView>
  </Node2D>
</Node2D>
