<StackView Name="BlockedPage" Spacing="12" PaddingBottom="24" Overflow="hidden scroll" JustifyContent="Start">
  <TextBlock Text="Blocked people's posts, reposts and comments are hidden from you here and they cannot contact you in Orca Messenger." TextResourceID="Blocked people's posts, reposts and comments are hidden from you here and they cannot contact you in Orca Messenger."
             FontSize="14" WordWrap="true" class="octopus-muted" IgnoreHitTest="true"/>
  <ItemsStack Name="BlockedPeople" Spacing="8" JustifyContent="Start" ItemNamePrefix="Blocked"
              ItemsSource="{Binding DataContext/Blocks/Items}" ItemTemplate="Octopus/Templates/BlockedPerson"/>
  <Node2D Name="BlocksLoading" Height="44" Visible="{Binding DataContext/Blocks/ShowProgress}" IgnoreHitTest="true">
    <ActivityIndicator class="octopus-dim"/>
  </Node2D>
  <TextBlock Name="BlocksEmpty" Visible="{Binding DataContext/Blocks/ShowEmpty}" Text="You have not blocked anyone."
             TextResourceID="You have not blocked anyone." FontSize="13" WordWrap="true" class="octopus-dim"/>
  <TextBlock Visible="{Binding DataContext/Unblock/IsExecuting}" Text="Unblocking…" TextResourceID="Unblocking…"
             FontSize="13" WordWrap="true" class="octopus-dim"/>
  <TextBlock Name="UnblockError" Visible="{Binding DataContext/Unblock/HasError}" Text="{Binding DataContext/Unblock/ErrorMessage}"
             FontSize="13" WordWrap="true" class="octopus-error"/>
  <StackView Visible="{Binding DataContext/Blocks/HasError}" Spacing="8" JustifyContent="Start">
    <TextBlock Text="{Binding DataContext/Blocks/ErrorMessage}" FontSize="13" WordWrap="true" class="octopus-error"/>
    <Button Name="RetryBlocks" Click="Blocks.Retry" Text="refresh" TextResourceID="refresh" Height="44"
            TextHorizontalAlignment="Left" TextVerticalAlignment="Center" class="octopus-action octopus-link"/>
  </StackView>
</StackView>
