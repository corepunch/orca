<!-- After creating an account (route /auth/picture): the random character the
     account starts with, and the ways to change it, over the Me scope
     (Data/Me.xml). Continue goes where sign-up was heading. -->
<StackView Name="PictureStep" Spacing="14" Overflow="hidden scroll" JustifyContent="Start">
  <TextBlock Text="We picked a sea creature for you. Keep it, choose another, or add a photo of yourself. You can change it later on your profile."
             TextResourceID="We picked a sea creature for you. Keep it, choose another, or add a photo of yourself. You can change it later on your profile."
             FontSize="15" WordWrap="true" class="octopus-muted" IgnoreHitTest="true"/>
  <!-- The tile's own DataContext is the profile record, so the page's
       visibility watch loads (and after a change reloads) its photo. -->
  <Grid Name="PictureAvatar" Width="160" Height="160" DataContext="{Binding DataContext/Profile}" StateClasses="{Binding DataContext/Tone}">
    <TextBlock Text="{Binding DataContext/Initials}" FontSize="56" class="avatar-initials"
               TextHorizontalAlignment="Center" TextVerticalAlignment="Center" IgnoreHitTest="true"/>
    <ImageView Name="AvatarPhoto" Visible="{Binding DataContext/HasAvatar}" Src="{Binding DataContext/AvatarPath}"
               ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
  </Grid>
  <TextBlock Name="PictureStatus" FontSize="13" WordWrap="true" class="octopus-dim"/>
  <StackView Spacing="10" JustifyContent="Start" IgnoreHitTest="{Binding DataContext/ChangePhoto/IsExecuting}">
    <Button Name="ChooseAvatar" Click="ToggleAvatarPicker" Text="Choose a character" TextResourceID="Choose a character"
            Height="44" BorderWidth="2" FontSize="15" FontWeight="Bold"
            TextHorizontalAlignment="Center" TextVerticalAlignment="Center" class="octopus-action octopus-outline"/>
    <StackView Name="DefaultAvatarPicker" Visible="false" Spacing="10" JustifyContent="Start">
      <GridBox Name="DefaultAvatarChoices" Columns="1fr 1fr 1fr" Spacing="8" ItemNamePrefix="Avatar"
               ItemsSource="{Binding DataContext/DefaultAvatars/Items}" ItemTemplate="Octopus/Templates/DefaultAvatar"/>
    </StackView>
  </StackView>
  <Button Name="ChangePhoto" Click="ChangePhoto" IgnoreHitTest="{Binding DataContext/ChangePhoto/IsExecuting}" Height="44"
          BorderWidth="2" FontSize="15" FontWeight="Bold" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
          class="octopus-action octopus-outline">
    <BindingExpression Target="TextResourceID">IF({DataContext/ChangePhoto/IsExecuting}, "Uploading photo…", "Upload a photo")</BindingExpression>
  </Button>
  <Button Name="TakePhoto" Click="TakePhoto" Visible="false" IgnoreHitTest="{Binding DataContext/TakePhoto/IsExecuting}" Height="44"
          BorderWidth="2" FontSize="15" FontWeight="Bold" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
          class="octopus-action octopus-outline">
    <BindingExpression Target="TextResourceID">IF({DataContext/TakePhoto/IsExecuting}, "Uploading photo…", "Take photo")</BindingExpression>
  </Button>
  <Button Name="PictureContinue" Click="FinishPicture" Text="Continue" TextResourceID="Continue" Height="48" FontSize="15" FontWeight="Bold"
          TextHorizontalAlignment="Center" TextVerticalAlignment="Center" class="octopus-action octopus-primary"/>
</StackView>
