<!-- The reader's profile form, under their profile on the me tab. -->
<StackView Name="ProfileEditor" Spacing="10" JustifyContent="Start">
  <TextBlock Text="edit profile" TextResourceID="edit profile" FontSize="20" class="octopus-accent-text" IgnoreHitTest="true"/>
  <Button Name="ChooseAvatar" Click="ToggleAvatarPicker" Text="Choose a character" TextResourceID="Choose a character"
          IgnoreHitTest="{Binding DataContext/ChangePhoto/IsExecuting}" Height="44" BorderWidth="2" FontSize="15" FontWeight="Bold"
          TextHorizontalAlignment="Center" TextVerticalAlignment="Center" class="octopus-action octopus-outline"/>
  <StackView Name="DefaultAvatarPicker" Visible="false" Spacing="10" JustifyContent="Start"
             IgnoreHitTest="{Binding DataContext/ChangePhoto/IsExecuting}">
    <TextBlock Text="Pick a sea creature. Your choice appears in Chat and on the website too." TextResourceID="Pick a sea creature. Your choice appears in Chat and on the website too." FontSize="13"
               WordWrap="true" class="octopus-dim" IgnoreHitTest="true"/>
    <GridBox Name="DefaultAvatarChoices" Columns="1fr 1fr 1fr" Spacing="8" ItemNamePrefix="Avatar"
             ItemsSource="{Binding DataContext/DefaultAvatars/Items}" ItemTemplate="Octopus/Templates/DefaultAvatar"/>
  </StackView>
  <Button Name="ChangePhoto" Click="ChangePhoto" IgnoreHitTest="{Binding DataContext/ChangePhoto/IsExecuting}" Height="44"
          BorderWidth="2" FontSize="15" FontWeight="Bold" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
          class="octopus-action octopus-outline">
    <BindingExpression Target="TextResourceID">IF({DataContext/ChangePhoto/IsExecuting}, "Uploading photo…", "Change photo")</BindingExpression>
  </Button>
  <!-- Shown by views/people.lua where the device has a camera. -->
  <Button Name="TakePhoto" Click="TakePhoto" Visible="false" IgnoreHitTest="{Binding DataContext/TakePhoto/IsExecuting}" Height="44"
          BorderWidth="2" FontSize="15" FontWeight="Bold" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
          class="octopus-action octopus-outline">
    <BindingExpression Target="TextResourceID">IF({DataContext/TakePhoto/IsExecuting}, "Uploading photo…", "Take photo")</BindingExpression>
  </Button>
  <TextBlock Text="name" TextResourceID="name" FontSize="14" class="octopus-muted" IgnoreHitTest="true"/>
  <Input Name="EditName" PlaceholderText="Your name" Height="44" FontSize="15" Padding="12 0" BorderWidth="2"
         Text="{Binding DataContext/ProfileForm/DisplayName, Mode=TwoWay}" class="octopus-input octopus-field"/>
  <TextBlock Text="bio" TextResourceID="bio" FontSize="14" class="octopus-muted" IgnoreHitTest="true"/>
  <Input Name="EditBio" PlaceholderText="A short bio" Multiline="true" Height="92" FontSize="15" Padding="12 10" BorderWidth="2"
         Text="{Binding DataContext/ProfileForm/Bio, Mode=TwoWay}" class="octopus-input octopus-field"/>
  <Button Name="SaveProfile" Click="ProfileForm.Submit" IgnoreHitTest="{Binding DataContext/ProfileForm/Status/IsSubmitting}"
          Height="48" FontSize="15" FontWeight="Bold" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
          class="octopus-action octopus-primary">
    <BindingExpression Target="TextResourceID">IF({DataContext/ProfileForm/Status/IsSubmitting}, "Saving…", "Save profile")</BindingExpression>
  </Button>
  <TextBlock Name="MeStatus" FontSize="13" WordWrap="true" class="octopus-dim"/>
  <!-- Twemoji's CC-BY license requires visible credit; see THIRD_PARTY_NOTICES.md. -->
  <TextBlock Text="about" TextResourceID="about" FontSize="14" MarginTop="12" class="octopus-muted" IgnoreHitTest="true"/>
  <TextBlock Name="Credits" Text="Emoji graphics by Twemoji, licensed under CC-BY 4.0. Noto fonts by Google, SIL Open Font License. Font rendering by FreeType (FreeType License). PNG decoding by libpng (libpng License) and JPEG decoding by libjpeg (IJG License). LZ4 compression by Yann Collet, BSD 2-Clause License. Lua by Lua.org, PUC-Rio, MIT License. Networking by curl (Daniel Stenberg, curl license), XML parsing by libxml2 (MIT License) and TLS by Mbed TLS (Apache License 2.0)."
             TextResourceID="Emoji graphics by Twemoji, licensed under CC-BY 4.0. Noto fonts by Google, SIL Open Font License. Font rendering by FreeType (FreeType License). PNG decoding by libpng (libpng License) and JPEG decoding by libjpeg (IJG License). LZ4 compression by Yann Collet, BSD 2-Clause License. Lua by Lua.org, PUC-Rio, MIT License. Networking by curl (Daniel Stenberg, curl license), XML parsing by libxml2 (MIT License) and TLS by Mbed TLS (Apache License 2.0)."
             FontSize="13" WordWrap="true" class="octopus-dim" IgnoreHitTest="true"/>
  <Button Name="SignOut" Click="SignOut" Height="44" BorderWidth="2" FontSize="15" FontWeight="Bold" MarginTop="12"
          TextHorizontalAlignment="Center" TextVerticalAlignment="Center" class="octopus-action octopus-danger">Sign out</Button>
</StackView>
