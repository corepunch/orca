<!-- Me: who you are in public, then where to go. Rows follow Settings
     (Telegram for Windows Phone's list): a 26-point icon in the 52-point
     avatar column, a 20-point lowercase name and a muted line saying what it
     holds. Sign out is the last command, in the error colour. -->
<StackView Name="MeContent" Spacing="24" Overflow="hidden scroll" JustifyContent="Start">
  <Grid Name="MeHeader" Columns="96px 1fr" Spacing="16" Height="96">
    <Grid Name="MeAvatarHost" Width="96" Height="96"/>
    <StackView Name="MeIdentity" Spacing="2" JustifyContent="Center" IgnoreHitTest="true">
      <TextBlock Name="MeName" FontSize="28" class="chat-ink" TextOverflow="Ellipsis" TextWrapping="NoWrap" IgnoreHitTest="true"/>
      <TextBlock Name="MeHandle" FontSize="15" class="chat-muted" TextOverflow="Ellipsis" TextWrapping="NoWrap" IgnoreHitTest="true"/>
    </StackView>
  </Grid>
  <StackView Name="MeRows" Spacing="6" JustifyContent="Start">
    <Button Name="MyPublicProfile" Height="64" BorderWidth="0" BackgroundColor="#00000000" class="chat-action chat-row">
      <Grid Columns="52px 1fr" Spacing="14" IgnoreHitTest="true">
        <VectorView Source="Chat/assets/icons/user-round.svg" Width="26" Height="26" MarginLeft="auto" MarginRight="auto"
                    MarginTop="auto" MarginBottom="auto" class="chat-accent-text" IgnoreHitTest="true"/>
        <StackView Spacing="0" JustifyContent="Center" IgnoreHitTest="true">
          <TextBlock FontSize="20" class="chat-ink" TextOverflow="Ellipsis" TextWrapping="NoWrap" IgnoreHitTest="true"
                     TextResourceID="public profile">public profile</TextBlock>
          <TextBlock Name="MyPublicProfileValue" FontSize="15" class="chat-muted" TextOverflow="Ellipsis" TextWrapping="NoWrap"
                     IgnoreHitTest="true" TextResourceID="Your bio and posts, open to everyone">Your bio and posts, open to everyone</TextBlock>
        </StackView>
      </Grid>
    </Button>
    <Button Name="MeSettings" Height="64" BorderWidth="0" BackgroundColor="#00000000" class="chat-action chat-row">
      <Grid Columns="52px 1fr" Spacing="14" IgnoreHitTest="true">
        <VectorView Source="Chat/assets/icons/settings.svg" Width="26" Height="26" MarginLeft="auto" MarginRight="auto"
                    MarginTop="auto" MarginBottom="auto" class="chat-accent-text" IgnoreHitTest="true"/>
        <StackView Spacing="0" JustifyContent="Center" IgnoreHitTest="true">
          <TextBlock FontSize="20" class="chat-ink" TextOverflow="Ellipsis" TextWrapping="NoWrap" IgnoreHitTest="true"
                     TextResourceID="settings">settings</TextBlock>
          <TextBlock Name="MeSettingsValue" FontSize="15" class="chat-muted" TextOverflow="Ellipsis" TextWrapping="NoWrap"
                     IgnoreHitTest="true" TextResourceID="Account, privacy, notifications">Account, privacy, notifications</TextBlock>
        </StackView>
      </Grid>
    </Button>
  </StackView>
  <Button Name="MeSignOut" Height="64" BorderWidth="0" BackgroundColor="#00000000" class="chat-action chat-row">
    <Grid Columns="52px 1fr" Spacing="14" IgnoreHitTest="true">
      <VectorView Source="Chat/assets/icons/log-out.svg" Width="26" Height="26" MarginLeft="auto" MarginRight="auto"
                  MarginTop="auto" MarginBottom="auto" class="chat-error" IgnoreHitTest="true"/>
      <TextBlock FontSize="20" class="chat-error" TextVerticalAlignment="Center" TextOverflow="Ellipsis" TextWrapping="NoWrap"
                 IgnoreHitTest="true" TextResourceID="sign out">sign out</TextBlock>
    </Grid>
  </Button>
  <TextBlock Name="MeStatus" FontSize="14" class="chat-error" WordWrap="true" Visible="false" IgnoreHitTest="true"/>
</StackView>
