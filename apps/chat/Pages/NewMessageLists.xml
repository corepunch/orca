<StackView Spacing="8" JustifyContent="Start">
  <StackView Name="DiscoveryResults" JustifyContent="Start">
    <Node2D Height="80">
      <BindingExpression Target="Visible">OR({DataContext/People/ShowProgress}, OR({DataContext/DeviceMatches/ShowProgress}, {DataContext/Channels/ShowProgress}))</BindingExpression>
      <ActivityIndicator Name="DiscoveryLoading" class="chat-muted"/>
    </Node2D>
    <ItemsStack ItemsSource="{Binding DataContext/People/Items}" ItemTemplate="Chat/Templates/Recipient"
                ItemNamePrefix="FoundPerson" JustifyContent="Start"/>
    <TextBlock Name="NoPeopleResults" Visible="{Binding DataContext/People/ShowEmpty}" FontSize="14" class="chat-muted"
               WordWrap="true" Padding="0 8"
               TextResourceID="No results. Ask them to set a public username in Profile, or enable Find me by email. You don't need to add a contact first.">No results. Ask them to set a public username in Profile, or enable Find me by email. You don't need to add a contact first.</TextBlock>
    <ItemsStack ItemsSource="{Binding DataContext/DeviceMatches/Items}" ItemTemplate="Chat/Templates/Recipient"
                ItemNamePrefix="FoundPersonContact" JustifyContent="Start"/>
    <TextBlock Name="NoContactMatches" Visible="{Binding DataContext/DeviceMatches/ShowEmpty}" FontSize="14" class="chat-muted"
               WordWrap="true" Padding="0 8"
               TextResourceID="None of your contacts can be found yet. Friends appear here once they turn on Find me by email.">None of your contacts can be found yet. Friends appear here once they turn on Find me by email.</TextBlock>
    <ItemsStack ItemsSource="{Binding DataContext/Channels/Items}" ItemTemplate="Chat/Templates/Recipient"
                ItemNamePrefix="JoinChannel" JustifyContent="Start"/>
    <TextBlock Name="NoChannelResults" Visible="{Binding DataContext/Channels/ShowEmpty}" FontSize="14" class="chat-muted"
               Padding="0 8" TextResourceID="No channels found.">No channels found.</TextBlock>
    <TextBlock Name="DiscoveryError" class="chat-error" FontSize="14" WordWrap="true">
      <BindingExpression Target="Visible">OR({DataContext/People/HasError}, OR({DataContext/DeviceMatches/HasError}, {DataContext/Channels/HasError}))</BindingExpression>
      <BindingExpression Target="Text">IF({DataContext/People/HasError}, {DataContext/People/ErrorMessage}, IF({DataContext/DeviceMatches/HasError}, {DataContext/DeviceMatches/ErrorMessage}, {DataContext/Channels/ErrorMessage}))</BindingExpression>
    </TextBlock>
  </StackView>
  <StackView Name="Contacts" JustifyContent="Start">
    <Node2D Visible="{Binding DataContext/Contacts/ShowLoading}" Height="80">
      <ActivityIndicator Name="ContactsLoading" class="chat-muted"/>
    </Node2D>
    <ItemsStack Name="RecipientContacts" ItemsSource="{Binding DataContext/Contacts/Items}" ItemTemplate="Chat/Templates/ContactSection"
                JustifyContent="Start"/>
    <TextBlock Visible="{Binding DataContext/Contacts/HasError}" Text="{Binding DataContext/Contacts/ErrorMessage}"
               class="chat-error" FontSize="14" WordWrap="true"/>
    <Button Name="RetryContacts" Visible="{Binding DataContext/Contacts/HasError}" Click="Contacts.Retry" Height="48" FontSize="15"
            TextHorizontalAlignment="Center" TextVerticalAlignment="Center" class="chat-action chat-link"
            TextResourceID="Retry contacts">Retry contacts</Button>
    <TextBlock Name="NoContacts" Visible="{Binding DataContext/Contacts/ShowEmpty}" FontSize="14" WordWrap="true" class="chat-dim"
               TextResourceID="No contacts yet. Search for someone by name or username to start a chat.">No contacts yet. Search for someone by name or username to start a chat.</TextBlock>
  </StackView>
</StackView>
