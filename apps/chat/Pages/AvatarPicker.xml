<Pivot Name="AvatarPicker" Title="Messenger" IsLocked="true" ExtendBodyBehindHeader="true"
       BackIcon="Chat/assets/icons/arrow-left.svg" BackRequested="CloseAvatarPicker" class="chat-background chat-ink">
  <PivotItem Header="characters">
    <StackView Name="AvatarChoicesBody" Padding="0 4" Spacing="6" Overflow="hidden scroll" JustifyContent="Start">
      <TextBlock Name="AvatarChoiceStatus" Visible="false" FontSize="14" WordWrap="true" class="chat-muted"/>
      <GridBox Name="AvatarChoices" Columns="1fr 1fr 1fr 1fr" Spacing="6" ItemNamePrefix="AvatarChoice"
               ItemsSource="{Binding DataContext/Choices/Items}" ItemTemplate="Chat/Templates/AvatarChoice"/>
    </StackView>
  </PivotItem>
</Pivot>
