<!-- Public timelines share the root Chat shell; creation and search are tasks. -->
<Grid Name="PostsPage" Rows="1fr auto" ContentInsetAdjustment="Always" class="chat-posts">
  <Node2D Name="PostsContent"/>
  <Grid Columns="1fr 1fr" Height="48" Padding="12 0" class="chat-background">
    <Button Name="NewPublicPost" Height="48" FontSize="17" TextHorizontalAlignment="Left"
            TextVerticalAlignment="Center" BorderWidth="0" class="chat-action chat-link" TextResourceID="new post">new post</Button>
    <Button Name="SearchPublicPosts" Height="48" FontSize="17" TextHorizontalAlignment="Right"
            TextVerticalAlignment="Center" BorderWidth="0" class="chat-action chat-link" TextResourceID="search posts">search posts</Button>
  </Grid>
</Grid>
