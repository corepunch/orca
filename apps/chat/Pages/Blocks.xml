<StackView Name="BlockedPeoplePage" Spacing="14" PaddingBottom="24" Overflow="hidden scroll" JustifyContent="Start">
  <TextBlock Text="Choose a person to unblock or report." TextResourceID="Choose a person to unblock or report." FontSize="15" WordWrap="true" class="chat-muted"/>
  <ItemsStack Name="BlockedPeople" ItemsSource="{Binding DataContext/Blocks/Items}" ItemTemplate="Chat/Templates/BlockedPerson" ItemNamePrefix="Blocked" Spacing="0"/>
  <TextBlock Visible="{Binding DataContext/Blocks/ShowEmpty}" Text="No blocked people." TextResourceID="No blocked people." FontSize="15" class="chat-muted"/>
  <ActivityIndicator Visible="{Binding DataContext/Blocks/ShowLoading}" class="chat-muted"/>
  <StackView Visible="{Binding DataContext/Blocks/ShowError}" Spacing="8">
    <TextBlock Text="{Binding DataContext/Blocks/ErrorMessage}" FontSize="15" WordWrap="true" class="chat-error"/>
    <Button Name="RetryBlocks" Click="Blocks.Retry" Text="Retry" TextResourceID="Retry" Height="48" FontSize="16" TextHorizontalAlignment="Left" TextVerticalAlignment="Center" BorderWidth="0" class="chat-action chat-link"/>
  </StackView>
</StackView>
