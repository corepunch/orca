<!-- The signed-in reader's conversations. One scope per session: the store
     is keyed by account, so another login never shows these records. -->
<DataScope Name="Inbox" Schema="Chat/Data/Chat.Schema.xml">
  <Query Name="Rooms" Entity="ChatRoom" Operation="rooms" Poll="15000" Loaded="roomsLoaded"
         Description="Rooms the reader belongs to, refreshed every 15 seconds while the inbox is visible."/>
  <Query Name="Contacts" Entity="ChatContact" Operation="contacts" AutoLoad="false" Loaded="contactsLoaded"/>
  <!-- Contacts panorama: everyone but the reader, a searchable list and a
       portrait wall led by recent direct conversations. -->
  <View Name="People" Source="Contacts" Filter="person" Sort="byName"/>
  <View Name="ContactList" Source="People" Filter="contactSearch">
    <Param Name="Search" Type="string"/>
  </View>
  <Query Name="Recent" Entity="ChatContact" Operation="recentContacts" AutoLoad="false"
         Description="People from the latest direct conversations, then the rest by name; at most 32. Local, no request."/>
  <Command Name="OpenContact" Operation="openContact" Parameter="Item"
           Description="Creates or reuses a private direct conversation and opens it."/>
  <Handler Name="RefreshContacts"/>
  <Handler Name="FindSomeone"/>
  <View Name="Matching" Source="Rooms" Filter="search"
        Description="Local search over loaded rooms; the service returns every room at once.">
    <Param Name="Search" Type="string"/>
  </View>
  <View Name="AllRooms" Source="Matching"/>
  <View Name="UnreadRooms" Source="Matching" Filter="unread"/>
  <View Name="PinnedRooms" Source="Matching" Filter="pinned"/>
  <Command Name="OpenRoom" Operation="openRoom" Parameter="Item" Sync="true"/>
  <Handler Name="ClearSearch"/>
  <Include Path="Chat/Data/Avatars.xml"/>
</DataScope>
