<!-- Data pages Chat opens by route. Each names its page and scope; the app
     supplies page chrome and navigation. Parameters come from the app. -->
<Routes>
  <Route Path="/blocked" Name="BlockedPeople" Page="Chat/Pages/Blocks" Scope="Chat/Data/Blocks.xml"
         Header="blocked people" Back="/profile" Description="Persisted block list with unblock and report actions."/>
  <Route Path="/details" Name="DetailsPage" Page="Chat/Pages/Details" Scope="Chat/Data/Details.xml"
         HeaderFrom="Room.Title" Back="/thread" Status="DetailsStatus" Description="A conversation's people, invitations and settings.">
    <Param Name="RoomId" From="room.id"/>
  </Route>
</Routes>
