<Button Height="64" class="chat-action chat-row" BorderWidth="0" BackgroundColor="#00000000" Click="SelectRecipient"
        StateClasses="{Binding DataContext/SelectionStyle}">
  <Grid Columns="52px 1fr" Spacing="14" Padding="0 6" IgnoreHitTest="true">
    <Grid Height="52" class="avatar" StateClasses="{Binding DataContext/Tone}" IgnoreHitTest="true">
      <TextBlock Text="{Binding DataContext/Initials}" FontSize="18" class="avatar-initials"
                 TextHorizontalAlignment="Center" TextVerticalAlignment="Center" IgnoreHitTest="true"/>
      <ImageView Name="AvatarPhoto" Visible="{Binding DataContext/HasAvatar}" Src="{Binding DataContext/AvatarPath}"
                 class="avatar" ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
    </Grid>
    <StackView Spacing="1" JustifyContent="Center" IgnoreHitTest="true">
      <TextBlock Text="{Binding DataContext/Title}" FontSize="20" class="chat-ink" TextOverflow="Ellipsis"
                 TextWrapping="NoWrap" IgnoreHitTest="true"/>
      <TextBlock Visible="{Binding DataContext/Subtitle}" Text="{Binding DataContext/Subtitle}" FontSize="14"
                 class="chat-dim" TextOverflow="Ellipsis" TextWrapping="NoWrap" IgnoreHitTest="true"/>
    </StackView>
  </Grid>
</Button>
