<Button Height="72" BorderWidth="0" class="chat-action chat-background" Click="ShareToRoom">
  <Grid Columns="52px 1fr" Spacing="14" Padding="0 10" IgnoreHitTest="true">
    <Grid Width="52" Height="52" class="avatar" StateClasses="{Binding DataContext/Tone, Mode=OneTime}" IgnoreHitTest="true">
      <TextBlock Text="{Binding DataContext/Initials, Mode=OneTime}" FontSize="18" class="avatar-initials" TextHorizontalAlignment="Center" TextVerticalAlignment="Center" IgnoreHitTest="true"/>
      <ImageView Visible="{Binding DataContext/HasAvatar, Mode=OneTime}" Src="{Binding DataContext/AvatarPath, Mode=OneTime}" class="avatar" ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
    </Grid>
    <StackView Spacing="2" JustifyContent="Center" IgnoreHitTest="true">
      <TextBlock Text="{Binding DataContext/Title, Mode=OneTime}" FontSize="22" class="chat-ink" TextOverflow="Ellipsis" IgnoreHitTest="true"/>
      <TextBlock Text="{Binding DataContext/KindText, Mode=OneTime}" FontSize="14" class="chat-muted" IgnoreHitTest="true"/>
    </StackView>
  </Grid>
</Button>
