<!-- One message, bound to a ChatMessage. Sender runs, permissions and the
     photo timestamp are record fields the conversation scope keeps current;
     the bubble's colours follow its sent or received state class. -->
<StackView Name="MessageEntry" Spacing="0" JustifyContent="Start">
  <StackView Name="MessageRow" Spacing="0" JustifyContent="Start" StateClasses="{Binding DataContext/Tone}"
             AlignItems="{Binding DataContext/Alignment}" MarginTop="{Binding DataContext/Gap}"
             PaddingLeft="{Binding DataContext/LeftInset}" PaddingRight="{Binding DataContext/RightInset}">
    <VectorView Name="IncomingTail" Source="Chat/assets/bubble-tail-up.svg" Visible="{Binding DataContext/IncomingTail}"
                Width="14" Height="12" MarginLeft="16" MarginRight="auto" class="bubble-tail" IgnoreHitTest="true"/>
    <Grid Name="MessageHolder">
      <StackView Name="MessageBubble" Width="{Binding DataContext/BubbleWidth}" PaddingLeft="{Binding DataContext/Inset}"
                 PaddingRight="{Binding DataContext/Inset}" PaddingTop="{Binding DataContext/VerticalInset}"
                 PaddingBottom="{Binding DataContext/VerticalInset}" Spacing="{Binding DataContext/SectionGap}"
                 JustifyContent="Start" class="bubble">
        <StackView Name="SenderSection" Visible="{Binding DataContext/ShowSender}" PaddingLeft="{Binding DataContext/PhotoInset}"
                   PaddingRight="{Binding DataContext/PhotoInset}" PaddingTop="{Binding DataContext/PhotoVerticalInset}"
                   PaddingBottom="{Binding DataContext/PhotoVerticalInset}" JustifyContent="Start">
          <TextBlock Name="MessageSender" Text="{Binding DataContext/Sender}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"
                     class="chat-accent-text" IgnoreHitTest="true"/>
        </StackView>
        <ItemsStack Name="Photos" Visible="{Binding DataContext/HasPhotos}" Spacing="0" JustifyContent="Start"
                    ItemNamePrefix="PhotoFrame" ItemsSource="{Binding DataContext/Attachments}" ItemTemplate="Chat/Templates/Photo"/>
        <StackView Name="Caption" Visible="{Binding DataContext/ShowCaption}" Spacing="2" JustifyContent="Start"
                   PaddingLeft="{Binding DataContext/PhotoInset}" PaddingRight="{Binding DataContext/PhotoInset}"
                   PaddingTop="{Binding DataContext/PhotoVerticalInset}" PaddingBottom="{Binding DataContext/PhotoVerticalInset}">
          <TextBlock Name="MessageBody" Visible="{Binding DataContext/HasBody}" Text="{Binding DataContext/Body}"
                     FontSize="16" TextWrapping="Wrap" class="bubble-ink" IgnoreHitTest="true"/>
          <TextBlock Name="MessageTime" Text="{Binding DataContext/Timestamp}" FontSize="11" TextHorizontalAlignment="Right"
                     class="bubble-meta" IgnoreHitTest="true"/>
        </StackView>
      </StackView>
      <Button Name="MessageActions" Visible="{Binding DataContext/CanAct}" Click="MessageActions"
              Width="{Binding DataContext/ActionsWidth}" Height="{Binding DataContext/ActionsWidth}"
              MarginLeft="{Binding DataContext/ActionsMargin}" MarginBottom="{Binding DataContext/ActionsMargin}"
              Text="{Binding DataContext/ActionsText}" FontSize="22" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
              BorderWidth="0" StateClasses="{Binding DataContext/ActionsStyle}" class="message-actions"/>
    </Grid>
    <VectorView Name="OutgoingTail" Source="Chat/assets/bubble-tail-down.svg" Visible="{Binding DataContext/OutgoingTail}"
                Width="14" Height="12" MarginLeft="auto" MarginRight="16" class="bubble-tail" IgnoreHitTest="true"/>
  </StackView>
</StackView>
