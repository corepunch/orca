<!-- One photo of a message, bound to a ChatAttachment. The Photos media
     member fills PhotoPath with the thumbnail, then the full photo; when the
     full photo fails, the thumbnail stays and retry appears. A photo without
     text carries the message time on the image. -->
<Grid Name="PhotoFrame" Width="{Binding DataContext/FrameWidth, Mode=OneTime}" Height="{Binding DataContext/FrameHeight, Mode=OneTime}"
      MarginLeft="{Binding DataContext/FrameLeft, Mode=OneTime}" MarginTop="{Binding DataContext/FrameTop, Mode=OneTime}"
      BorderTopLeftRadius="{Binding DataContext/CornerTopLeft, Mode=OneTime}" BorderTopRightRadius="{Binding DataContext/CornerTopRight, Mode=OneTime}"
      BorderBottomLeftRadius="{Binding DataContext/CornerBottomLeft, Mode=OneTime}" BorderBottomRightRadius="{Binding DataContext/CornerBottomRight, Mode=OneTime}"
      class="chat-soft">
  <Grid Name="PhotoContent">
    <VectorView Name="PhotoLoading" Visible="{Binding DataContext/Pending, Mode=OneTime}" Source="Chat/assets/icons/refresh-cw.svg"
                Width="32" Height="32" MarginLeft="auto" MarginRight="auto" MarginTop="auto" MarginBottom="auto" class="chat-muted" IgnoreHitTest="true"/>
    <ImageView Name="Photo" Visible="{Binding DataContext/HasPhoto, Mode=OneTime}" Src="{Binding DataContext/PhotoPath, Mode=OneTime}"
               ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"
               BorderTopLeftRadius="{Binding DataContext/CornerTopLeft, Mode=OneTime}" BorderTopRightRadius="{Binding DataContext/CornerTopRight, Mode=OneTime}"
               BorderBottomLeftRadius="{Binding DataContext/CornerBottomLeft, Mode=OneTime}" BorderBottomRightRadius="{Binding DataContext/CornerBottomRight, Mode=OneTime}"/>
  </Grid>
  <Button Name="OpenPhoto" Click="OpenPhoto" IgnoreHitTest="{Binding DataContext/Failed, Mode=OneTime}" BackgroundColor="#00000000" BorderWidth="0"/>
  <Button Name="RetryPhoto" Visible="{Binding DataContext/Failed, Mode=OneTime}" Click="Photos.Retry" Height="44" FontSize="12"
          MarginTop="auto" MarginBottom="auto" TextHorizontalAlignment="Center" TextVerticalAlignment="Center"
          BorderWidth="0" class="chat-action chat-link" Text="{Binding DataContext/RetryLabel, Mode=OneTime}"/>
  <TextBlock Name="PhotoTime" Visible="{Binding DataContext/ShowTime, Mode=OneTime}" Text="{Binding DataContext/Timestamp, Mode=OneTime}"
             FontSize="11" Padding="4 2" MarginLeft="auto" MarginTop="auto" MarginRight="6" MarginBottom="6"
             class="photo-time" IgnoreHitTest="true"/>
</Grid>
