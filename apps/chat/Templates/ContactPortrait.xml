<!-- One tile of the Contacts portrait wall: the photo, or initials until it loads. -->
<Button class="chat-action" BorderWidth="0" BackgroundColor="#00000000" Click="OpenContact">
  <Grid Name="ContactAvatar" class="avatar" StateClasses="{Binding DataContext/Tone, Mode=OneTime}" IgnoreHitTest="true">
    <TextBlock Text="{Binding DataContext/Initials, Mode=OneTime}" FontSize="24" class="avatar-initials"
               TextHorizontalAlignment="Center" TextVerticalAlignment="Center" IgnoreHitTest="true"/>
    <ImageView Name="AvatarPhoto" Visible="{Binding DataContext/HasAvatar, Mode=OneTime}" class="avatar" Src="{Binding DataContext/AvatarPath, Mode=OneTime}"
               ForegroundColor="#ffffff" Stretch="UniformToFill" IgnoreHitTest="true"/>
  </Grid>
</Button>
