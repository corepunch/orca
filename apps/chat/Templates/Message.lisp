(StackView Name="MessageEntry" Spacing=0 JustifyContent="Start"
  (StackView Name="MessageRow" Spacing=0 JustifyContent="Start" StateClasses=(bind "DataContext/Tone") AlignItems=(bind "DataContext/Alignment") MarginTop=(bind "DataContext/Gap") PaddingLeft=(bind "DataContext/LeftInset") PaddingRight=(bind "DataContext/RightInset")
    (VectorView Name="IncomingTail" Source="Chat/assets/bubble-tail-up.svg" Visible=(bind "DataContext/IncomingTail") Width=14 Height=12 MarginLeft=16 MarginRight="auto" class="bubble-tail" IgnoreHitTest=true)
    (Grid Name="MessageHolder"
      (StackView Name="MessageBubble" Width=(bind "DataContext/BubbleWidth") PaddingLeft=(bind "DataContext/Inset") PaddingRight=(bind "DataContext/Inset") PaddingTop=(bind "DataContext/VerticalInset") PaddingBottom=(bind "DataContext/VerticalInset") Spacing=(bind "DataContext/SectionGap") JustifyContent="Start" class="bubble"
        (StackView Name="SenderSection" Visible=(bind "DataContext/ShowSender") PaddingLeft=(bind "DataContext/PhotoInset") PaddingRight=(bind "DataContext/PhotoInset") PaddingTop=(bind "DataContext/PhotoVerticalInset") PaddingBottom=(bind "DataContext/PhotoVerticalInset") JustifyContent="Start"
          (TextBlock Name="MessageSender" Text=(bind "DataContext/Sender") FontSize=13 FontWeight="Bold" TextWrapping="Wrap" class="chat-accent-text" IgnoreHitTest=true))
        (ItemsStack Name="Photos" Visible=(bind "DataContext/HasPhotos") Spacing=0 JustifyContent="Start" ItemNamePrefix="PhotoFrame" ItemsSource=(bind "DataContext/Attachments") ItemTemplate="Chat/Templates/Photo")
        (StackView Name="Caption" Visible=(bind "DataContext/ShowCaption") Spacing=2 JustifyContent="Start" PaddingLeft=(bind "DataContext/PhotoInset") PaddingRight=(bind "DataContext/PhotoInset") PaddingTop=(bind "DataContext/PhotoVerticalInset") PaddingBottom=(bind "DataContext/PhotoVerticalInset")
          (TextBlock Name="MessageBody" Visible=(bind "DataContext/HasBody") Text=(bind "DataContext/Body") FontSize=16 TextWrapping="Wrap" class="bubble-ink" IgnoreHitTest=true)
          (TextBlock Name="MessageTime" Text=(bind "DataContext/Timestamp") FontSize=11 TextHorizontalAlignment="Right" class="bubble-meta" IgnoreHitTest=true)))
      (Button Name="MessageActions" Visible=(bind "DataContext/CanAct") Click="MessageActions" Width=(bind "DataContext/ActionsWidth") Height=(bind "DataContext/ActionsWidth") MarginLeft=(bind "DataContext/ActionsMargin") MarginBottom=(bind "DataContext/ActionsMargin") Text=(bind "DataContext/ActionsText") FontSize=22 TextHorizontalAlignment="Center" TextVerticalAlignment="Center" BorderWidth=0 StateClasses=(bind "DataContext/ActionsStyle") class="message-actions"))
    (VectorView Name="OutgoingTail" Source="Chat/assets/bubble-tail-down.svg" Visible=(bind "DataContext/OutgoingTail") Width=14 Height=12 MarginLeft="auto" MarginRight=16 class="bubble-tail" IgnoreHitTest=true)))
