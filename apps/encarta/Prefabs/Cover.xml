<?xml version="1.0" encoding="UTF-8"?>
<Button AspectRatio="0.67" class="cover">
    <Node2D IgnoreHitTest="true">
        <VectorView Name="Icon" Width="76" Height="76" MarginLeft="auto" MarginRight="auto"
            MarginTop="auto" MarginBottom="auto" class="cover-icon" IgnoreHitTest="true"/>
        <ImageView Name="Art" Stretch="UniformToFill" Visible="false" class="cover-art" IgnoreHitTest="true"/>
        <ImageView Src="encarta/Images/cover-shade.png" Stretch="Fill" class="cover-art" IgnoreHitTest="true"/>
        <StackView JustifyContent="End" class="cover-copy" IgnoreHitTest="true">
            <TextBlock Name="Title" class="cover-title" WordWrap="true" IgnoreHitTest="true"/>
        </StackView>
    </Node2D>
</Button>
