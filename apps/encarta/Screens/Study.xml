      <Camera Name="StudyCamera" Fov="42" FovType="Yfov" ZNear="0.2" ZFar="30"
              LayoutTransform="0 1.62 3.75  -7.5 0 0  1 1 1"/>
      <PrefabView3D Name="Room" Prefab="encarta/Study/Scene"/>
    </Scene>
  </Viewport3D>
</Screen>
