<!-- A big answer an activity gives (`cards`): "frost tonight", "storm clock",
     "tides". A bar in the card's tone, the question small, the answer big,
     a line of why, an optional icon, and up to three links that ask the
     activity to act ("good", "fair", "poor" for a session just surfed). -->
<Grid Columns="4 1fr auto" Spacing="12" StateClasses="{Binding DataContext/Tone}">
  <StackView class="wx-bar" IgnoreHitTest="true"/>
  <StackView Spacing="0" JustifyContent="Start">
    <TextBlock Name="CardTitle" Text="{Binding DataContext/Title}" FontSize="14" class="wx-dim" IgnoreHitTest="true"/>
    <TextBlock Name="CardValue" Text="{Binding DataContext/Value}" FontSize="30" WordWrap="true" class="wx-tone"
               IgnoreHitTest="true"/>
    <TextBlock Name="CardDetail" Text="{Binding DataContext/Detail}" Visible="{Binding DataContext/HasDetail}" FontSize="14"
               WordWrap="true" class="wx-dim" IgnoreHitTest="true"/>
    <StackView Name="CardActions" Visible="{Binding DataContext/HasActions}" Direction="Horizontal" Spacing="24"
               JustifyContent="Start">
      <Button Name="CardAction1" Click="CardAction" Text="{Binding DataContext/ActionText1}" Height="44" BorderWidth="0"
              FontSize="20" class="wx-link"/>
      <Button Name="CardAction2" Click="CardAction" Text="{Binding DataContext/ActionText2}"
              Visible="{Binding DataContext/HasAction2}" Height="44" BorderWidth="0" FontSize="20" class="wx-link"/>
      <Button Name="CardAction3" Click="CardAction" Text="{Binding DataContext/ActionText3}"
              Visible="{Binding DataContext/HasAction3}" Height="44" BorderWidth="0" FontSize="20" class="wx-link"/>
    </StackView>
  </StackView>
  <VectorView Name="CardIcon" Source="{Binding DataContext/Icon}" Visible="{Binding DataContext/HasIcon}" Width="32"
              Height="32" class="wx-ink" IgnoreHitTest="true"/>
</Grid>
