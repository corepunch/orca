<!-- What the place is good for: an activity, its verdict in its tone, and
     its best window with the reason. Tapping opens the activity. -->
<Button Height="80" Click="OpenActivity" BorderWidth="0" AccessibilityLabel="{Binding DataContext/Summary}"
        AccessibilityHint="opens the activity" class="wx-row">
  <Grid Columns="4 1fr auto" Spacing="12" StateClasses="{Binding DataContext/Tone}" IgnoreHitTest="true">
    <StackView class="wx-bar" IgnoreHitTest="true"/>
    <StackView Spacing="0" JustifyContent="Center" IgnoreHitTest="true">
      <TextBlock Name="ActivityName" Text="{Binding DataContext/Title}" FontSize="28" class="wx-ink" IgnoreHitTest="true"/>
      <TextBlock Name="ActivityWhy" Text="{Binding DataContext/Detail}" FontSize="14" WordWrap="true" class="wx-dim"
                 IgnoreHitTest="true"/>
    </StackView>
    <TextBlock Name="ActivityVerdict" Text="{Binding DataContext/Value}" FontSize="22" class="wx-tone" IgnoreHitTest="true"/>
  </Grid>
</Button>
