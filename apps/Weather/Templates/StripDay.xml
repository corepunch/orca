<!-- One day of Amazing Weather's five-day strip: an underlined lowercase
     weekday, the sky, high, low and the chance of rain. -->
<StackView Spacing="4" JustifyContent="Start"
           AccessibilityLabel="{Binding DataContext/Summary}" IgnoreHitTest="true">
  <TextBlock Name="StripWeekday" Text="{Binding DataContext/Title}" FontSize="20" TextHorizontalAlignment="Center"
             class="wx-ink" IgnoreHitTest="true"/>
  <StackView Height="2" MarginLeft="4" MarginRight="4" class="wx-rule" IgnoreHitTest="true"/>
  <VectorView Source="{Binding DataContext/Icon}" Width="28" Height="28" MarginLeft="auto" MarginRight="auto" class="wx-ink"/>
  <TextBlock Name="StripHigh" Text="{Binding DataContext/Value}" FontSize="18" TextHorizontalAlignment="Center"
             class="wx-ink" IgnoreHitTest="true"/>
  <TextBlock Text="{Binding DataContext/Detail}" FontSize="14" TextHorizontalAlignment="Center"
             class="wx-dim" IgnoreHitTest="true"/>
  <TextBlock Text="{Binding DataContext/Note}" FontSize="13" TextHorizontalAlignment="Center"
             class="wx-accent" IgnoreHitTest="true"/>
</StackView>
