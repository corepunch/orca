<!-- The place hub, the page of one activity or one day there, settings,
     adding a place and the place editor. -->
<Routes>
  <Route Path="/" Name="HubPage" Page="Weather/Pages/Hub" Scope="Weather/Data/Hub.xml"/>
  <Route Path="/activity" Name="ActivityPage" Page="Weather/Pages/Activity" Scope="Weather/Data/Activity.xml">
    <Param Name="PlaceId" From="place.id"/>
    <Param Name="ActivityId" From="activity.id"/>
  </Route>
  <Route Path="/day" Name="DayPage" Page="Weather/Pages/Day" Scope="Weather/Data/Day.xml">
    <Param Name="PlaceId" From="place.id"/>
    <Param Name="Date" From="date"/>
  </Route>
  <Route Path="/settings" Name="SettingsPage" Page="Weather/Pages/Settings" Scope="Weather/Data/Settings.xml"/>
  <Route Path="/search" Name="SearchPage" Page="Weather/Pages/Search" Scope="Weather/Data/Search.xml"/>
  <Route Path="/place" Name="PlacePage" Page="Weather/Pages/Place" Scope="Weather/Data/Place.xml"/>
</Routes>
