<!-- The place hub over Data/Hub.xml: a Panorama titled with the place, after
     Bing Weather's hub and Amazing Weather's "now" page (DESIGN.md). Each
     "good for" row opens that activity's page; "places" switches place. -->
<Grid Name="HubPage" Rows="1fr" ContentInsetAdjustment="Always" class="wx-page">
  <Panorama Name="HubPanorama" Title="{Binding DataContext/PlaceList/Selected/Title}" ContentInsetAdjustment="Always"
            class="wx-ink">
    <PanoramaItem Name="NowSection" Header="now">
      <StackView Name="NowBody" Spacing="14" Overflow="hidden scroll" JustifyContent="Start">
        <Grid Name="ReportLoading" Height="96" IgnoreHitTest="true">
          <BindingExpression Target="Visible">AND({DataContext/Report/ShowLoading}, NOT({DataContext/Report/HasItems}))</BindingExpression>
          <ActivityIndicator class="wx-dim"/>
        </Grid>
        <StackView Name="ReportFailed" Visible="{Binding DataContext/Report/ShowError}" Spacing="8" JustifyContent="Start">
          <TextBlock Name="ReportError" Text="{Binding DataContext/Report/ErrorMessage}" FontSize="18" WordWrap="true"
                     class="wx-poor" IgnoreHitTest="true"/>
          <Button Name="RetryReport" Click="Report.Retry" Height="44" BorderWidth="0" FontSize="20"
                  TextHorizontalAlignment="Left" class="wx-link">try again</Button>
        </StackView>
        <ItemsStack Name="NowItems" Spacing="0" JustifyContent="Start" ItemNamePrefix="Now"
                    ItemsSource="{Binding DataContext/Now/Items}" ItemTemplate="Weather/Templates/HubNow"/>
        <ItemsStack Name="DetailItems" Spacing="2" JustifyContent="Start" ItemNamePrefix="Detail"
                    ItemsSource="{Binding DataContext/Details/Items}" ItemTemplate="Weather/Templates/DetailRow"/>
        <ItemsStack Name="StripItems" Direction="Horizontal" Spacing="4" JustifyContent="Start" ItemNamePrefix="Strip"
                    ItemsSource="{Binding DataContext/Strip/Items}" ItemTemplate="Weather/Templates/StripDay"/>
        <Button Name="RefreshReport" Click="Report.Refresh" Visible="{Binding DataContext/Report/HasItems}" Height="44"
                BorderWidth="0" FontSize="18" TextHorizontalAlignment="Left" class="wx-link">
          <BindingExpression Target="Text">IF({DataContext/Report/IsRefreshing}, "refreshing…", "refresh")</BindingExpression>
        </Button>
      </StackView>
    </PanoramaItem>
    <PanoramaItem Name="GoodForSection" Header="good for">
      <ItemsStack Name="GoodForItems" Spacing="10" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="GoodFor"
                  ItemsSource="{Binding DataContext/GoodFor/Items}" ItemTemplate="Weather/Templates/GoodForRow"/>
    </PanoramaItem>
    <PanoramaItem Name="HoursSection" Header="hourly">
      <ItemsStack Name="HourItems" Spacing="6" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Hour"
                  ItemsSource="{Binding DataContext/Hours/Items}" ItemTemplate="Weather/Templates/ForecastRow"/>
    </PanoramaItem>
    <PanoramaItem Name="DaysSection" Header="week">
      <ItemsStack Name="DayItems" Spacing="10" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Day"
                  ItemsSource="{Binding DataContext/Days/Items}" ItemTemplate="Weather/Templates/ForecastRow"/>
    </PanoramaItem>
    <PanoramaItem Name="PlacesSection" Header="places">
      <ItemsStack Name="PlaceItems" Spacing="12" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Place"
                  ItemsSource="{Binding DataContext/PlaceList/Items}" ItemTemplate="Weather/Templates/PlaceRow"/>
    </PanoramaItem>
  </Panorama>
</Grid>
