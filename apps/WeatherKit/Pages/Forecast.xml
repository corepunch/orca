<!-- The forecast panorama over Data/Forecast.xml, after the Windows Phone
     weather hub: the verdict now and why, the next hours, the week, the
     profile's conditions and the spots. The app sets the panorama title
     to the profile's name; everything else binds. -->
<Grid Name="ForecastPage" Rows="1fr" ContentInsetAdjustment="Always" class="wx-page">
  <Panorama Name="WeatherPanorama" Title="weather" ContentInsetAdjustment="Always" class="wx-ink">
    <PanoramaItem Name="NowSection" Header="now">
      <StackView Name="NowBody" Spacing="14" Overflow="hidden scroll" JustifyContent="Start">
        <Grid Name="ReportLoading" Height="96" IgnoreHitTest="true">
          <BindingExpression Target="Visible">AND({DataContext/Report/ShowLoading}, NOT({DataContext/Report/HasItems}))</BindingExpression>
          <ActivityIndicator class="wx-dim"/>
        </Grid>
        <StackView Name="ReportFailed" Visible="{Binding DataContext/Report/ShowError}" Spacing="8" JustifyContent="Start">
          <TextBlock Name="ReportError" Text="{Binding DataContext/Report/ErrorMessage}" FontSize="18" WordWrap="true"
                     class="wx-poor" IgnoreHitTest="true"/>
          <Button Name="RetryReport" Click="Report.Retry" Height="44" BorderWidth="0" FontSize="20"
                  TextHorizontalAlignment="Left" class="wx-link">try again</Button>
        </StackView>
        <ItemsStack Name="NowItems" Spacing="0" JustifyContent="Start" ItemNamePrefix="Now"
                    ItemsSource="{Binding DataContext/Now/Items}" ItemTemplate="WeatherKit/Templates/NowCard"/>
        <ItemsStack Name="ReasonItems" Spacing="10" JustifyContent="Start" ItemNamePrefix="Reason"
                    ItemsSource="{Binding DataContext/Reasons/Items}" ItemTemplate="WeatherKit/Templates/ReasonRow"/>
        <Button Name="RefreshReport" Click="Report.Refresh" Visible="{Binding DataContext/Report/HasItems}" Height="44"
                BorderWidth="0" FontSize="18" TextHorizontalAlignment="Left" class="wx-link">
          <BindingExpression Target="Text">IF({DataContext/Report/IsRefreshing}, "refreshing…", "refresh")</BindingExpression>
        </Button>
      </StackView>
    </PanoramaItem>
    <PanoramaItem Name="HoursSection" Header="hourly">
      <ItemsStack Name="HourItems" Spacing="6" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Hour"
                  ItemsSource="{Binding DataContext/Hours/Items}" ItemTemplate="WeatherKit/Templates/ForecastRow"/>
    </PanoramaItem>
    <PanoramaItem Name="DaysSection" Header="week">
      <ItemsStack Name="DayItems" Spacing="10" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Day"
                  ItemsSource="{Binding DataContext/Days/Items}" ItemTemplate="WeatherKit/Templates/ForecastRow"/>
    </PanoramaItem>
    <PanoramaItem Name="ConditionsSection" Header="conditions">
      <ItemsStack Name="ConditionItems" Spacing="16" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Condition"
                  ItemsSource="{Binding DataContext/Conditions/Items}" ItemTemplate="WeatherKit/Templates/MetricRow"/>
    </PanoramaItem>
    <PanoramaItem Name="SpotsSection" Header="spots">
      <ItemsStack Name="SpotItems" Spacing="12" JustifyContent="Start" Overflow="hidden scroll" ItemNamePrefix="Spot"
                  ItemsSource="{Binding DataContext/SpotList/Items}" ItemTemplate="WeatherKit/Templates/SpotRow"/>
    </PanoramaItem>
  </Panorama>
</Grid>
