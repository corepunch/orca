<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "https://corepunch.github.io/orca/schemas/cgen.dtd">
<module name="notifications" namespace="orca" prefix="notifications_">
  <includes><include file="include/api.h"/></includes>
  <functions>
    <function name="Supported" lua="true">
      <summary>Reports whether this application supports native remote notifications.</summary>
      <details>True for Apple application bundles; false for other platforms and command-line tools. APNs registration additionally requires a matching signed push entitlement, provisioning profile and provider.</details>
      <returns type="nresults">A boolean indicating support.</returns>
    </function>
    <function name="RequestAuthorization" lua="true">
      <summary>Requests notification permission and registers this device with APNs asynchronously.</summary>
      <details>Returns true when queued, or nil and an error string when unsupported. Poll for a token or error after completion. Call on each launch and account restoration; APNs may rotate the token. Repeated requests replay the latest token while refreshing registration. Permission is requested only by this explicit call.</details>
      <returns type="nresults">True when queued, or nil and an error string.</returns>
    </function>
    <function name="SetBadgeCount" lua="true">
      <summary>Shows a number on the application icon; zero clears it.</summary>
      <details>Takes a non-negative integer, typically the unread total. Returns true when applied, or nil and an error string where the platform has no application icon badge. Requires the badge permission granted by RequestAuthorization; without it the system ignores the number.</details>
      <returns type="nresults">True, or nil and an error string.</returns>
    </function>
    <function name="SetActiveConversation" lua="true">
      <summary>Names the conversation on screen, or clears it with nil.</summary>
      <details>While the application is in the foreground, a notification for another conversation shows as a banner with sound; one for the active conversation stays silent because the open thread refreshes itself. Opening a conversation also removes its delivered notifications from the notification center.</details>
      <returns type="nresults">True.</returns>
    </function>
    <function name="RequestLocalAuthorization" lua="true">
      <summary>Asks to show alerts with sound for local notifications, without registering with APNs.</summary>
      <details>Returns true when queued, or nil and an error string when unsupported. The system asks once; later calls answer at once. Poll returns an event of type authorized, or error with code permission_denied. Call it only from an explicit user action, such as switching notifications on.</details>
      <returns type="nresults">True when queued, or nil and an error string.</returns>
    </function>
    <function name="ScheduleLocal" lua="true">
      <summary>Schedules a local notification: { id, title, body, at }.</summary>
      <details>`at` is Unix seconds; a time already past shows in about a second. `id` (letters, digits, `-`, `_`, `.` and `:`, at most 96 bytes) names it, so scheduling the same id again replaces it. Title and body are plain text, at most 256 and 1024 bytes. Delivered only when the person allowed notifications. Returns true when handed to the system, or nil and an error string.</details>
      <returns type="nresults">True, or nil and an error string.</returns>
    </function>
    <function name="CancelLocal" lua="true">
      <summary>Cancels a scheduled local notification by id, or every one this module scheduled when called without an id.</summary>
      <details>Also removes a delivered one with that id from Notification Center. Remote notifications are never touched. Returns true, or nil and an error string when unsupported.</details>
      <returns type="nresults">True, or nil and an error string.</returns>
    </function>
    <function name="ScheduleRefresh" lua="true">
      <summary>Asks iOS for a background refresh no sooner than the given number of seconds.</summary>
      <details>Submits a BGAppRefreshTaskRequest named after the bundle identifier with a .refresh suffix; the bundle must permit it (package.lua `Capabilities = { "background-refresh" }`) and carry a project background.lua returning a function. When iOS runs the task, that function runs in a Lua state of its own without screens or engine objects (orca.network, orca.notifications and a region-only orca.core are available), resumed until it returns or the system expires it. The system decides whether and when; it may never run, for example in Low Power Mode. Returns true when submitted, or nil and an error string.</details>
      <returns type="nresults">True, or nil and an error string.</returns>
    </function>
    <function name="WriteWidgetSnapshot" lua="true">
      <summary>Writes a JSON snapshot for the application's widgets into its App Group container.</summary>
      <details>Takes a string of at most 16 KiB and saves it atomically as widget.json in the container of the App Group named by the bundle's ORCAAppGroup Info.plist key, which `make ios WIDGETS=1` sets to group.&lt;bundle id&gt; together with the App Groups entitlement; a WidgetKit extension in the same group reads it. The extension refreshes on its own timeline: writing does not reload it. Returns true, or nil and an error string when the build has no App Group, the container is unavailable (the group is not provisioned for the signing team) or the write failed.</details>
      <returns type="nresults">True, or nil and an error string.</returns>
    </function>
    <function name="Poll" lua="true">
      <summary>Dequeues one native notification event on the Lua thread.</summary>
      <details>Returns nil when empty. Events have type token (token), received or open (conversationId, messageId, userId), or error (code, message). Error codes include permission_denied, authorization_failed, registration_failed, invalid_token and unsupported. Notification payload identifiers are untrusted routing hints and must be authorized by the application. Open events survive startup before Lua initialization. Platform callbacks never access Lua.</details>
      <returns type="nresults">An event table, or nil.</returns>
    </function>
  </functions>
</module>
