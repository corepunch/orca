<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "https://corepunch.github.io/orca/schemas/cgen.dtd">
<module name="media" namespace="orca" prefix="media_">
  <includes>
    <include file="include/api.h"/>
  </includes>
  <functions>
    <function name="PickPhoto" lua="true">
      <summary>Selects and prepares one still photo using the native macOS file dialog or iOS photo picker.</summary>
      <details>Returns the same result as processPhoto, or nil and a table containing code and message. Cancel returns code cancelled. The macOS dialog is synchronous and modal. On iOS, selection yields the application coroutine while the system picker is open; calls outside a yieldable coroutine return not_yieldable and overlapping pickers return busy. Abandoning the coroutine dismisses its picker. The iOS picker grants access only to the selected photo without requesting photo-library permission. Picking is unsupported on non-Apple platforms. No file is uploaded or retained.</details>
      <returns type="nresults">A processed-photo table, or nil and a structured error.</returns>
    </function>
    <function name="TakePhoto" lua="true">
      <summary>Takes and prepares one still photo with the iOS camera.</summary>
      <details>Returns the same result as processPhoto, or nil and a table containing code and message. Cancel returns code cancelled. Like pickPhoto on iOS, the call yields the application coroutine while the system camera is open; calls outside a yieldable coroutine return not_yieldable and overlapping pickers return busy. The system asks for camera permission on first use, using the app's NSCameraUsageDescription; a denied permission returns code permission. Devices without a camera and non-iOS platforms return unsupported; check canTakePhoto before offering the action. No file is uploaded or retained.</details>
      <returns type="nresults">A processed-photo table, or nil and a structured error.</returns>
    </function>
    <function name="CanTakePhoto" lua="true">
      <summary>Reports whether takePhoto can open a camera on this device.</summary>
      <details>True only on iOS devices with an available camera and permission that has not been denied or restricted. Simulators and other platforms return false.</details>
      <returns type="nresults">A boolean.</returns>
    </function>
    <function name="ProcessPhoto" lua="true">
      <summary>Converts encoded still-image bytes into an oriented, metadata-free sRGB JPEG and thumbnail.</summary>
      <details>Apple ImageIO downsampling bounds decode to 1500000 pixels and 1600 pixels on the longest edge, never enlarging. Inputs are limited to 32 MiB, 100 million source pixels and a 32768-pixel source edge; multiple-frame sources are rejected. Transparency is flattened against neutral RGB 245/255. JPEG quality starts at 0.82, with a 0.60 floor and a hard limit of 250000 bytes. Quality is reduced before dimensions, with bounded dimension reductions from the decoded original down to an 800-pixel longest edge (or the source edge when smaller); images that still exceed the budget return an encode error. Thumbnail longest edge is at most 256. Source EXIF/GPS metadata is not copied. Synchronous processing returns jpeg and thumbnail as binary Lua strings, width, height, byte_count, thumbnail_width, thumbnail_height, thumbnail_byte_count, mime_type and quality. Non-Apple processing returns unsupported.</details>
      <arg name="bytes" type="string">Raw encoded image bytes, including embedded NUL bytes.</arg>
      <returns type="nresults">A processed-photo table, or nil and a table containing code and message.</returns>
    </function>
    <function name="PhotoFilters" lua="true">
      <summary>Lists the photo filter identifiers accepted by filterPhoto, starting with normal.</summary>
      <details>Filters are per-pixel colour grades with optional vignettes, ported from the image editor's Instagram-style presets. Identifiers are lowercase names such as clarendon, valencia or inkwell; normal leaves colours unchanged.</details>
      <returns type="nresults">An array of filter identifier strings.</returns>
    </function>
    <function name="FilterPhoto" lua="true">
      <summary>Applies a named filter to encoded still-image bytes and prepares the result like processPhoto.</summary>
      <details>The source is decoded and bounded exactly as processPhoto does, the filter is applied to the decoded sRGB pixels, and the result is encoded with the same JPEG budget and thumbnail. Pass the unfiltered processed photo each time to avoid compounding grades and JPEG generations. Unknown filters return code unknown_filter. Non-Apple processing returns unsupported.</details>
      <arg name="bytes" type="string">Raw encoded image bytes, including embedded NUL bytes.</arg>
      <arg name="filter" type="string">A filter identifier from photoFilters.</arg>
      <returns type="nresults">A processed-photo table, or nil and a table containing code and message.</returns>
    </function>
  </functions>
</module>
