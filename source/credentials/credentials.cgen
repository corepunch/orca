<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module SYSTEM "https://corepunch.github.io/orca/schemas/cgen.dtd">
<module name="credentials" namespace="orca" prefix="credentials_">
  <includes>
    <include file="include/api.h"/>
  </includes>
  <functions>
    <function name="Supported" lua="true">
      <summary>Reports whether this platform implements secure credential storage.</summary>
      <details>True on Apple platforms. This checks platform support, not whether the Keychain is currently unlocked or accessible.</details>
      <returns type="nresults">A boolean indicating platform support.</returns>
    </function>
    <function name="Get" lua="true">
      <summary>Reads a private credential from the Apple Keychain.</summary>
      <details>Keys are nonempty UTF-8 strings of at most 1024 bytes without NUL. Storage is scoped to the application bundle identifier (org.orca.credentials for an unbundled executable). Returns nil when absent; errors return nil and a table containing code and message. Unsupported platforms return unsupported, never a plaintext fallback.</details>
      <arg name="key" type="string">Application-defined credential key.</arg>
      <returns type="nresults">Credential bytes, nil when absent, or nil and an error.</returns>
    </function>
    <function name="Set" lua="true">
      <summary>Synchronously saves or replaces a credential in the Apple Keychain.</summary>
      <details>Values are limited to 64 KiB. Credentials are accessible only while the device is unlocked, are not synchronized, and cannot migrate to another device. A successful return means Keychain accepted the write; no shutdown callback is needed. Errors return nil and a table containing code and message.</details>
      <arg name="key" type="string">Application-defined credential key.</arg>
      <arg name="value" type="string">Private credential bytes, including embedded NUL bytes.</arg>
      <returns type="nresults">True on success, or nil and an error.</returns>
    </function>
    <function name="Delete" lua="true">
      <summary>Deletes a private credential from the Apple Keychain.</summary>
      <details>Deleting an absent key succeeds. Unsupported platforms return unsupported. Errors return nil and a table containing code and message.</details>
      <arg name="key" type="string">Application-defined credential key.</arg>
      <returns type="nresults">True on success, or nil and an error.</returns>
    </function>
  </functions>
</module>
