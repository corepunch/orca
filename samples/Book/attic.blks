<?xml version='1.0' encoding='UTF-8'?>
<scene ambient="0.35 0.37 0.43" background="midnight">
  <camera name="floor-show-room" comment="Wide floor-level map; upper-left wall reserved for story text" pos="340 215 310" look="55 100 -105" fov="61" />
  <camera name="floor-show-cleared-room" comment="The floor after Mira takes the brass star" pos="340 215 310" look="55 100 -105" fov="61"><transform target="BrassStar" pos="0 -1000 0" /></camera>
  <camera name="floor-take-gold-star" comment="Mira, the nest and the brass star at floor level" pos="-55 70 230" look="-145 15 75" fov="55" />
  <camera name="floor-climb-table" comment="Mira climbs the book steps toward the tabletop" pos="365 75 170" look="245 55 15" fov="50"><transform target="Mira" pos="436 30 -13" rot="0 180 0" /></camera>
  <camera name="table-go-floor" comment="Mira descends the book steps toward the nest" pos="345 145 175" look="170 55 8" fov="59"><transform target="Mira" pos="330 90 -13" rot="0 180 0" /></camera>
  <camera name="table-show-desk" comment="Desk geography, pencil, copper star and window" pos="380 235 135" look="125 95 -105" fov="66" />
  <camera name="table-show-cleared-desk" comment="The desk after Mira takes the copper star" pos="380 235 135" look="125 95 -105" fov="66"><transform target="CopperStar" pos="0 -1000 0" /></camera>
  <camera name="table-take-copper-star" comment="Copper star among the paper and pencil" pos="200 155 35" look="76 98 -88" fov="40" />
  <camera name="table-climb-sill" comment="Mira climbs the folded postcards toward the sill" pos="330 235 -150" look="160 155 -295" fov="52"><transform target="Mira" pos="336 200 -318" rot="0 90 0" /></camera>
  <camera name="sill-go-table" comment="Mira descends the postcards toward the desk" pos="42 250 -360" look="160 145 -220" fov="58"><transform target="Mira" pos="336 200 -318" rot="0 180 0" /></camera>
  <camera name="sill-show-window" comment="Open window, sill and Mira beside the pearl star" pos="200 275 -165" look="218 205 -350" fov="58"><transform target="Mira" pos="336 200 -373" /></camera>
  <camera name="sill-take-pearl-star" comment="Pearl star against the wooden window frame" pos="270 235 -315" look="218 208 -355" fov="45" />
  <camera name="attic-return-stars" comment="Mira reunites the three stars beside her paper constellation" pos="-20 150 240" look="-80 35 82" fov="52"><transform target="Mira" pos="-14 0 40" /><transform target="CopperStar" pos="-148 -90 170" /><transform target="PearlStar" pos="-244 -200 437" /></camera>
  <material id="plaster" color="0.42 0.43 0.48" shininess="2" />
  <material id="dark_wood" color="0.30 0.22 0.18" shininess="10" />
  <material id="wood" color="0.48 0.30 0.16" shininess="12" />
  <material id="paper" color="0.78 0.71 0.56" shininess="2" />
  <material id="paper_blue" color="0.28 0.45 0.60" shininess="4" />
  <material id="brass_star" color="0.88 0.52 0.10" shininess="55" />
  <material id="copper_star" color="0.69 0.26 0.10" shininess="50" />
  <material id="pearl_star" color="0.76 0.82 0.91" shininess="68" />
  <material id="mouse_fur" color="0.38 0.40 0.45" shininess="5" />
  <material id="pink" color="0.77 0.34 0.43" shininess="12" />
  <light pos="100 286 -110" color="1.0 0.72 0.42" intensity="1.15" radius="600" castShadows="1" />
  <light pos="170 255 -315" color="0.48 0.60 0.92" intensity="0.42" radius="500" castShadows="0" />
  <sun dir="0.35 -1 -0.75" color="0.46 0.59 0.92" intensity="0.72" castShadows="1" />
  <!-- Open camera side is a deliberate boundary so every story shot can see the room. -->
  <box pos="0 -8 -100" size="800 16 600" material="dark_wood" />
  <box pos="0 348 -100" size="800 12 600" material="plaster" />
  <group pos="0 0 -400">
    <wall length="800" height="342" thickness="20" material="plaster" />
    <bool-negative-box pos="170 255 0" size="200 120 30" />
  </group>
  <wall pos="-400 0 -100" rot="0 90 0" length="600" height="342" thickness="20" material="plaster" />
  <wall pos="400 0 -100" rot="0 90 0" length="600" height="342" thickness="20" material="plaster" />
  <!-- Window frame and sill: the opening is empty so the moonlit background remains visible. -->
  <box pos="78 255 -384" size="12 120 12" material="wood" />
  <box pos="262 255 -384" size="12 120 12" material="wood" />
  <box pos="170 312 -384" size="200 12 12" material="wood" />
  <box pos="170 257 -384" size="8 102 10" material="wood" />
  <box pos="170 194 -365" size="220 12 50" material="wood" />
  <!-- Desk remains in the same coordinates in every shot. -->
  <box pos="110 85 -100" size="280 10 130" material="wood" />
  <box pos="-12 40 -152" size="12 80 12" material="dark_wood" />
  <box pos="232 40 -152" size="12 80 12" material="dark_wood" />
  <box pos="-12 40 -48" size="12 80 12" material="dark_wood" />
  <box pos="232 40 -48" size="12 80 12" material="dark_wood" />
  <!-- A broad, three-step book stair touches the floor and desk edge. -->
  <box pos="280 15 5" size="80 30 80" material="paper_blue" />
  <box pos="200 30 5" size="80 60 80" material="paper" />
  <box pos="120 45 5" size="80 90 80" material="paper_blue" />
  <!-- The second route is a stepped stack of folded postcards from desk to sill. -->
  <box pos="160 108 -192.5" size="68 36 55" material="paper_blue" />
  <box pos="160 126 -247.5" size="68 72 55" material="paper" />
  <box pos="160 145 -307.5" size="68 110 65" material="paper_blue" />
  <!-- Work in progress on the tabletop. -->
  <box pos="5 91.5 -105" size="86 3 56" material="paper" />
  <box pos="67 94 -98" rot="0 0 -5" size="56 2 42" material="paper_blue" />
  <cylinder pos="25 94.5 -45" rot="0 0 90" radius="4.5" height="92" material="wood" />
  <cone pos="74 94.5 -45" rot="0 0 90" radius="4.5" radiusTop="0" height="16" material="pink" />
  <!-- Three unique star tokens, each on its story surface. -->
  <group name="BrassStar" pos="-118 4.5 82"><prism radius="20" height="9" sides="5" material="brass_star" /></group>
  <group name="CopperStar" pos="76 94.5 -88"><prism radius="20" height="9" sides="5" material="copper_star" /></group>
  <group name="PearlStar" pos="218 204.5 -355"><prism radius="20" height="9" sides="5" material="pearl_star" /></group>
  <!-- Floor nest and its paper constellation landmark. -->
  <sphere pos="-255 10 112" scale="1.65 0.45 1.20" radius="28" material="paper" />
  <box pos="-244 2 55" rot="0 -8 0" size="92 4 62" material="paper_blue" />
  <box pos="-212 6 55" rot="0 -8 0" size="16 4 16" material="brass_star" />
  <box pos="-242 6 55" rot="0 -8 0" size="16 4 16" material="paper" />
  <box pos="-270 6 55" rot="0 -8 0" size="16 4 16" material="paper" />
  <!-- Mira, a deliberately simple, shadow-casting mouse blockout at the first star. -->
  <group name="Mira" pos="-176 0 18">
    <group scale="0.6 0.6 0.6">
    <sphere pos="0 12.4 0" radius="20" scale="1.35 0.62 0.78" material="mouse_fur" />
    <sphere pos="22 22 0" radius="15" scale="1.0 0.95 0.90" material="mouse_fur" />
    <sphere pos="23 34 9" radius="7.5" scale="0.78 1.20 0.42" material="pink" />
    <sphere pos="23 34 -9" radius="7.5" scale="0.78 1.20 0.42" material="pink" />
    <sphere pos="34 19 0" radius="4.5" scale="1.1 0.72 0.82" material="pink" />
    <sphere pos="27 25.5 10.8" radius="1.8" material="dark_wood" />
    <sphere pos="27 25.5 -10.8" radius="1.8" material="dark_wood" />
    <cylinder pos="-28 10 0" rot="0 0 72" radius="2.2" height="25" material="mouse_fur" />
    <cylinder pos="-39 6.5 0" rot="0 0 72" radius="1.8" height="20" material="pink" />
    </group>
  </group>
  <!-- Visible ceiling lamp motivates the warm point-light key. -->
  <cylinder pos="100 325 -110" radius="2.5" height="35" material="dark_wood" />
  <cone pos="100 306 -110" radius="30" radiusTop="8" height="22" material="wood" />
  <sphere pos="100 292 -110" radius="8" color="1.0 0.80 0.48" unlit="1" castShadow="0" />
  <!-- Small rafters and a loose paper strip make the attic readable without cluttering text zones. -->
  <box pos="-270 320 -382" rot="0 0 8" size="16 18 120" material="dark_wood" />
  <box pos="300 320 -382" rot="0 0 -8" size="16 18 120" material="dark_wood" />
  <box pos="-320 3 -50" rot="0 12 0" size="44 6 16" material="paper" />
</scene>
