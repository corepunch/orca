<?xml version="1.0"?>
<!-- BLOCKOUT — Wondertown: Snowy Alley (Exterior)
     X=east/west (-600 to 600, width=1200cm)
     Y=north/south (0 to 1000, depth=1000cm)
     Z=up (Ground Z=0, Wall height Z=540cm)
     South wall (Workshop rear) Y=0
     North wall (Opposite building) Y=1000 -->
<scene ambient="0.08 0.12 0.18" background="midnight">

  <!-- ==================== PRODUCTION CAMERAS ==================== -->
  <!-- 1. ESTABLISHING: High SW corner looking along snowy alley toward streetlamp and footprints -->
  <camera name="SnowyAlleyEstablishing" comment="High SW diagonal view of snowy alley, toy streetlamp, and pet door"
          pos="-480 120 340" look="80 720 120" fov="68"/>

  <!-- ==================== MATERIALS ==================== -->
  <material id="snow"        color="0.75 0.82 0.90" shininess="16"/>
  <material id="brick_dark"  color="0.32 0.24 0.22" shininess="4"/>
  <material id="wood_dark"   color="0.28 0.18 0.12" shininess="12"/>
  <material id="iron_lamp"   color="0.15 0.15 0.18" shininess="30"/>

  <!-- ==================== MOTIVATED LIGHTING ==================== -->
  <!-- 1. Direct moonlight from clear winter night sky -->
  <sun dir="-0.65 -0.30 -0.70" color="0.50 0.70 0.98" intensity="1.2" castShadows="1"/>

  <!-- 2. Repurposed toy streetlamp flickering on pole -->
  <light pos="240 650 260" color="1.0 0.80 0.45" intensity="2.8" radius="450" castShadows="1"/>

  <!-- ==================== ENVIRONMENT SHELL ==================== -->
  <!-- Snow-covered ground plane (1200cm wide × 1000cm deep) -->
  <box pos="0 500 -5" size="1200 1000 10" material="snow" castShadow="0" sanityFloor="1"/>

  <!-- South Wall (Workshop Back Wall) with Pet Door & Back Door -->
  <wall pos="0 0 0" length="1200" height="540" thickness="24" material="brick_dark"/>
  <bool-negative-arch pos="-100 0 160" width="180" height="300" depth="50"/>
  <bool-negative-arch pos="-100 0 50"  width="90" height="100" depth="50"/>

  <!-- North Wall (Opposite Building) -->
  <wall pos="0 1000 0" length="1200" height="540" thickness="24" material="brick_dark"/>

  <!-- ==================== SEMANTIC BLOCKOUT MASSES ==================== -->

  <!-- 1. TOY STREETLAMP MOUNTED ON POLE (Midground right) -->
  <box pos="240 650 130" size="16 16 260" material="iron_lamp"/>
  <box pos="240 650 270" size="40 40 50"  material="iron_lamp"/>

  <!-- 2. WORKSHOP BACK DOOR & PET DOOR (South wall left) -->
  <box pos="-100 0 160" size="170 12 290" material="wood_dark"/>

  <!-- 3. SNOW DRIFTS & CRATES (Along North wall) -->
  <box pos="-320 920 30" size="240 120 60" material="snow"/>
  <box pos="380 920 40"  size="180 140 80" material="snow"/>

  <!-- ==================== NAMED INTERACTION ANCHORS ==================== -->
  <group name="WORKSHOP-DOOR" pos="-100 0 160"/>
  <group name="PET-DOOR"      pos="-100 0  50"/>
  <group name="TOY-STREETLAMP" pos="240 650 260"/>

</scene>
