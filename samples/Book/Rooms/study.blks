<?xml version="1.0"?>
<!-- BLOCKOUT — Alone in the Dark style: Derceto Manor Occult Study & Library
     X=east/west (-600 to 600, width=1200cm)
     Y=north/south (0 to 1000, depth=1000cm)
     Z=up (Floor Z=0, Ceiling Z=540cm)
     South wall Y=0   North wall Y=1000
     West wall X=-600 East wall X=600 -->
<scene ambient="0.04 0.05 0.07" background="midnight">

  <!-- ==================== PRODUCTION CAMERAS ==================== -->

  <!-- 1. ESTABLISHING: High SW corner looking diagonally across room.
       Height=380 (70% of 540), pitch=24 deg down, FOV=68 deg.
       Shows converging North & East walls, distinct foreground/mid/background layers.
       Lower-right floor is text-safe negative space. -->
  <camera name="StudyEstablishing" comment="High SW corner diagonal; two converging walls; lower-right floor text-safe"
          pos="-520 90 380" look="60 640 90" fov="68"/>

  <!-- 2. FOCUS: Investigator's Desk & Occult Documents.
       Isolates the desk, armchair, and arched window light. -->
  <camera name="DeskInspection" comment="Medium focus on desk workspace and armchair backlit by west window"
          pos="-390 320 150" look="-200 540 75" fov="56"/>

  <!-- 3. SUSPENSE: Low-angle dramatic shot from the hearth.
       Low height (Z=60), upward tilt towards towering bookcase, clock, and ominous corridor door. -->
  <camera name="HearthSuspense" comment="Low-angle suspense from hearth looking up towards clock and dark corridor exit"
          pos="440 280 60" look="-100 760 190" fov="72"/>

  <!-- 4. REVERSE / THRESHOLD: View looking back into study from North doorway. -->
  <camera name="CorridorThreshold" comment="Threshold shot looking from north doorway back across the room towards the desk and window"
          pos="220 940 220" look="-150 420 90" fov="62"/>

  <!-- 5. LAYOUT PLAN: Top-down map view just below ceiling for continuity review. -->
  <camera name="LayoutPlan" comment="Top-down orthographic plan view for spatial and route verification"
          pos="0 500 530" look="0 500 0" fov="92"/>

  <!-- ==================== MATERIALS ==================== -->
  <material id="wood_dark"   color="0.45 0.30 0.20" shininess="24"/>
  <material id="wood_oak"    color="0.65 0.45 0.28" shininess="12"/>
  <material id="wallpaper"   color="0.38 0.52 0.45" shininess="4"/>
  <material id="stone"       color="0.55 0.52 0.50" shininess="8"/>
  <material id="floor"       color="0.35 0.30 0.26" shininess="12"/>
  <material id="leather"     color="0.60 0.22 0.18" shininess="18"/>
  <material id="brass"       color="0.90 0.78 0.35" shininess="40"/>
  <material id="ceiling_mat" color="0.35 0.28 0.22" shininess="8"/>

  <!-- ==================== MOTIVATED LIGHTING (Doom 3 Style Local Pools) ==================== -->
  <!-- 1. Cool pale moonlight pooling through west arched window -->
  <light pos="-590 520 270" color="0.35 0.55 0.95" intensity="2.2" radius="340" castShadows="1"/>

  <!-- 2. Intense warm flickering firelight in east hearth - local round pool on hearth and floor -->
  <light pos="470 480 60" color="1.0 0.52 0.15" intensity="2.6" radius="280" castShadows="1"/>

  <!-- 3. Focused gas reading lamp over central study desk -->
  <light pos="-240 520 180" color="1.0 0.90 0.65" intensity="2.4" radius="280" castShadows="1"/>

  <!-- 4. North wall gas sconce creating round light scallop on wallpaper beside bookcase -->
  <light pos="-140 970 240" color="1.0 0.82 0.50" intensity="2.0" radius="260" castShadows="1"/>

  <!-- 5. Northeast corner sconce near grandfather clock -->
  <light pos="460 760 240" color="1.0 0.80 0.45" intensity="1.8" radius="240" castShadows="1"/>

  <!-- ==================== ROOM SHELL ==================== -->
  <!-- Floor & Ceiling (1200cm wide × 1000cm deep × 540cm high) -->
  <box pos="0 500 -5"  size="1200 1000 10" material="floor" castShadow="0" sanityFloor="1"/>
  <box pos="0 500 545" size="1200 1000 12" material="ceiling_mat" castShadow="1"/>

  <!-- North, West, East, South Walls -->
  <wall pos="0 1000 0"    length="1200" height="540" thickness="24" material="wallpaper"/>
  <wall pos="-600 500 0"  rot="0 0 90" length="1000" height="540" thickness="24" material="wallpaper"/>
  <wall pos=" 600 500 0"  rot="0 0 90" length="1000" height="540" thickness="24" material="wallpaper"/>
  <wall pos="0 0 0"       length="1200" height="540" thickness="24" material="wallpaper" renderable="0" castShadow="0"/>

  <!-- Openings:
       West wall: Arched stained-glass window
       North wall: Corridor double-door passage -->
  <bool-negative-arch pos="-600 520 270" rot="0 0 90" width="180" height="320" depth="50"/>
  <bool-negative-arch pos="220 1000 160" width="180" height="320" depth="50"/>

  <!-- ==================== ARCHITECTURAL FIXTURES ==================== -->
  <!-- Grand Masonry Fireplace & Chimney Breast (East Wall) -->
  <box pos="560 480 270" size="80 280 540" material="stone"/>
  <box pos="520 480 20"  size="160 320 40" material="stone"/>
  <bool-negative-arch pos="600 480 80" rot="0 0 90" width="140" height="160" depth="100"/>
  <box pos="500 480 165" size="50 300 12" material="wood_dark"/>

  <!-- ==================== SEMANTIC BLOCKOUT MASSES ==================== -->

  <!-- 1. INVESTIGATOR'S PARTNER'S DESK & ARMCHAIR (West-center midground) -->
  <!-- Heavy dark wood desk -->
  <box pos="-240 520 45" size="220 120 90" material="wood_dark"/>
  <!-- Desktop bookstand / letter rack -->
  <box pos="-240 560 98" size="140 30 16" material="wood_dark"/>
  <!-- High-backed oxblood leather armchair behind desk -->
  <box pos="-240 390 55" size="90 90 110" material="leather"/>

  <!-- 2. GRAND OCCULT BOOKCASE & ROLLING LADDER (NW Wall) -->
  <!-- Giant wall bookcase (420cm wide × 480cm tall) -->
  <box pos="-350 950 240" size="420 70 480" material="wood_oak"/>
  <!-- Rolling library ladder angled against shelves -->
  <box pos="-180 880 240" size="14 48 480" material="wood_dark"/>

  <!-- 3. CURIO DISPLAY CABINET & GRANDFATHER CLOCK (NE Wall / Corner) -->
  <!-- Tall curio cabinet with glass/wood mass -->
  <box pos="520 820 140" size="90 180 280" material="wood_dark"/>
  <!-- Ominous grandfather clock ticking near hearth -->
  <box pos="550 680 135" size="60 60 270" material="wood_dark"/>

  <!-- 4. CHESTERFIELD READING SOFA & PARLOR TABLE (Foreground East / SE) -->
  <!-- Deep oxblood leather sofa -->
  <box pos="180 240 45" size="110 220 90" material="leather"/>
  <!-- Parlor side table with heavy pedestal -->
  <box pos="340 240 35" size="70 70 70" material="wood_dark"/>
  <!-- Heavy brass candelabra -->
  <box pos="340 240 85" size="24 24 30" material="brass"/>

  <!-- 5. ANTIQUE REINFORCED IRON/WOOD TRUNK (Foreground SW corner) -->
  <box pos="-480 180 35" size="80 140 70" material="wood_dark"/>

  <!-- ==================== NAMED INTERACTION ANCHORS ==================== -->
  <group name="DESK-LEDGER"        pos="-240 520  90"/>
  <group name="OCCULT-TOME"        pos="-350 950 180"/>
  <group name="FIREPLACE-HEARTH"   pos="520  480  40"/>
  <group name="GRANDFATHER-CLOCK"  pos="550  680 140"/>
  <group name="CORRIDOR-DOOR"      pos="220  990 160"/>
  <group name="STAINED-WINDOW"     pos="-590 520 270"/>
  <group name="ANTIQUE-TRUNK"      pos="-480 180  70"/>

</scene>
