  <attach name="top_surface" pos="0 13 36" />
  <group name="book_step_1">
    <box material="red" castShadow="1" pos="0 0 1" size="70 50 2" />
    <box material="red" castShadow="1" pos="0 0 11" size="70 50 2" />
    <box material="paper" castShadow="1" pos="0 0.8 6" size="66 46 8" />
    <box material="red" castShadow="1" pos="0 -24 6" size="70 2 8" />
    <box material="brass" castShadow="1" pos="-27 -25.2 6" size="2 0.4 10" />
    <box material="brass" castShadow="1" pos="27 -25.2 6" size="2 0.4 10" />
  </group>
  <group name="book_step_2">
    <box material="teal" castShadow="1" pos="0 7 13" size="64 36 2" />
