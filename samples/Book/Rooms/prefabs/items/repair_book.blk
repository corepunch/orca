  <attach name="top" pos="0 18 0"/>
  <prefab source="items/book" scale="1.4 1.4 1.4"/>
  <box pos="8 17.5 0" rot="0 35 0" size="16 1.2 16" color="0.72 0.47 0.12" shininess="58"/>
  <torus pos="8 18.4 0" majorRadius="5.5" minorRadius="1.2" color="0.72 0.47 0.12" shininess="58"/>
</prefab>
