<?xml version="1.0" encoding="UTF-8"?>
<!-- workbench: footprint 2.0x0.9, baseline y=0, top surface at y=0.94.
     Front is +Z. Work from the +Z side. Lower shelf at y=0.38. -->
<prefab>
  <attach name="top_surface" pos="0 94 0"/>
  <attach name="under_center" pos="0 12 0"/>
  <box pos="0 90 0" size="200 8 90" material="wood"/>
  <box pos="0 38 0" size="180 4 75" material="wood"/>
  <prism pos="-90 44 -38" radius="4" height="88" sides="4" material="wood"/>
  <prism pos="90 44 -38" radius="4" height="88" sides="4" material="wood"/>
  <prism pos="-90 44 38" radius="4" height="88" sides="4" material="wood"/>
  <prism pos="90 44 38" radius="4" height="88" sides="4" material="wood"/>
</prefab>
