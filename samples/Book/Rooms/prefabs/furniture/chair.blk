<?xml version="1.0" encoding="UTF-8"?>
<!-- chair: footprint 0.45x0.45, baseline y=0, backrest at z=-0.2.
     Front direction is +Z (backrest = -Z).
     Rotate around Y to change facing: rotY(+90) -> faces +X, rotY(-90) -> faces -X. -->
<prefab>
  <attach name="seat" pos="0 0.475 0"/>
  <box pos="0 0.45 0" size="0.45 0.05 0.45" material="wood"/>
  <box pos="0 0.75 -0.2" size="0.45 0.55 0.05" material="wood"/>
  <prism pos="-0.18 0.225 -0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
  <prism pos=" 0.18 0.225 -0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
  <prism pos="-0.18 0.225  0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
  <prism pos=" 0.18 0.225  0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
</prefab>
