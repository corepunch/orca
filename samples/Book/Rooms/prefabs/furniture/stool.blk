<?xml version="1.0" encoding="UTF-8"?>
<!-- stool: footprint 0.4x0.4, baseline y=0, seat at y=0.62.
     Rotationally symmetric, no natural front. -->
<prefab>
  <box pos="0 60 0" size="40 4 40" material="wood"/>
  <prism pos="-16 30 -16" radius="2.2" height="60" sides="4" material="wood"/>
  <prism pos="16 30 -16" radius="2.2" height="60" sides="4" material="wood"/>
  <prism pos="-16 30 16" radius="2.2" height="60" sides="4" material="wood"/>
  <prism pos="16 30 16" radius="2.2" height="60" sides="4" material="wood"/>
</prefab>
