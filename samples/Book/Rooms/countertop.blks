<?xml version="1.0"?>
<!-- BLOCKOUT — Wondertown: Countertop & Glass Display Case
     X=east/west (-600 to 600, width=1200cm)
     Y=north/south (0 to 1000, depth=1000cm)
     Z=up (Floor Z=0, Ceiling Z=540cm)
     South wall Y=0   North wall Y=1000
     West wall X=-600 East wall X=600 -->
<scene ambient="0.08 0.10 0.14" background="midnight">

  <!-- ==================== PRODUCTION CAMERAS ==================== -->
  <!-- 1. ESTABLISHING: High SW corner looking across countertop toward frosted window and display case -->
  <camera name="CountertopEstablishing" comment="High SW diagonal view of shop countertop, glass case, and window"
          pos="-500 120 340" look="60 680 120" fov="68"/>

  <!-- 2. FOCUS: Marzipan (Ragdoll against window) -->
  <camera name="MarzipanFocus" comment="Focus on Marzipan sitting against the frosted shop window"
          pos="120 480 180" look="360 820 140" fov="52"/>

  <!-- ==================== MATERIALS ==================== -->
  <material id="wood_dark"   color="0.35 0.22 0.14" shininess="20"/>
  <material id="wood_oak"    color="0.55 0.38 0.22" shininess="12"/>
  <material id="wallpaper"   color="0.28 0.38 0.34" shininess="4"/>
  <material id="glass"       color="0.65 0.80 0.85" shininess="40"/>
  <material id="fabric_rag"  color="0.58 0.35 0.42" shininess="6"/>
  <material id="brass"       color="0.88 0.75 0.32" shininess="36"/>

  <!-- ==================== MOTIVATED LIGHTING ==================== -->
  <!-- 1. Cool winter moonlight streaming through grand shop window (North wall) -->
  <light pos="360 1020 280" color="0.45 0.65 0.95" intensity="3.2" radius="550" castShadows="1"/>

  <!-- 2. Warm counter brass lamp -->
  <light pos="-240 500 280" color="1.0 0.85 0.55" intensity="2.2" radius="420" castShadows="1"/>

  <!-- ==================== ROOM SHELL ==================== -->
  <box pos="0 500 -5"  size="1200 1000 10" material="wood_oak" castShadow="0" sanityFloor="1"/>
  <box pos="0 500 545" size="1200 1000 12" material="wood_dark" castShadow="1"/>

  <wall pos="0 1000 0"    length="1200" height="540" thickness="24" material="wallpaper"/>
  <wall pos="-600 500 0"  rot="0 0 90" length="1000" height="540" thickness="24" material="wallpaper"/>
  <wall pos=" 600 500 0"  rot="0 0 90" length="1000" height="540" thickness="24" material="wallpaper"/>
  <wall pos="0 0 0"       length="1200" height="540" thickness="24" material="wallpaper" renderable="0" castShadow="0"/>

  <!-- Large frosted shop window (North wall) -->
  <bool-negative-arch pos="360 1000 260" width="360" height="340" depth="50"/>

  <!-- ==================== SEMANTIC BLOCKOUT MASSES ==================== -->

  <!-- 1. DUSTY GLASS DISPLAY CASE (Center of countertop) -->
  <box pos="-100 680 90" size="360 220 180" material="glass"/>
  <box pos="-100 680 2"  size="370 230 6"   material="wood_dark"/>

  <!-- 2. MARZIPAN (Patchwork ragdoll sitting against frosted window) -->
  <box pos="360 860 40" size="50 50 70" material="fabric_rag"/>

  <!-- 3. COUNTERTOP BRASS LAMP & LEDGER -->
  <box pos="-360 480 80" size="30 30 160" material="brass"/>
  <box pos="-320 480 8"  size="80 60 12"  material="wood_dark"/>

  <!-- ==================== NAMED INTERACTION ANCHORS ==================== -->
  <group name="MARZIPAN"     pos="360  860 40"/>
  <group name="DISPLAY-CASE" pos="-100 680 90"/>
  <group name="SHOP-WINDOW"  pos="360  980 260"/>

</scene>
