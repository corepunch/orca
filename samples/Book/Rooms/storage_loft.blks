<?xml version="1.0"?>
<!-- BLOCKOUT — Wondertown: Storage Loft & Rafters
     X=east/west (-600 to 600, width=1200cm)
     Y=north/south (0 to 1000, depth=1000cm)
     Z=up (Floor Z=0, Ceiling Z=420cm)
     South wall Y=0   North wall Y=1000
     West wall X=-600 East wall X=600 -->
<scene ambient="0.05 0.06 0.08" background="midnight">

  <!-- ==================== PRODUCTION CAMERAS ==================== -->
  <!-- 1. ESTABLISHING: Diagonal shot across dim storage loft showing rafters and repair box -->
  <camera name="StorageLoftEstablishing" comment="Diagonal view across storage loft, crates, and repair box"
          pos="-480 120 280" look="80 680 90" fov="68"/>

  <!-- ==================== MATERIALS ==================== -->
  <material id="wood_dark"   color="0.35 0.22 0.14" shininess="20"/>
  <material id="wood_oak"    color="0.55 0.38 0.22" shininess="12"/>
  <material id="cardboard"   color="0.52 0.42 0.28" shininess="4"/>
  <material id="plaster"     color="0.32 0.38 0.34" shininess="4"/>

  <!-- ==================== MOTIVATED LIGHTING ==================== -->
  <!-- 1. Single dusty lantern hanging from rafter -->
  <light pos="0 500 280" color="1.0 0.82 0.50" intensity="2.2" radius="420" castShadows="1"/>

  <!-- 2. Cool gap light from roof shingle gap -->
  <light pos="320 800 320" color="0.45 0.60 0.90" intensity="1.4" radius="320" castShadows="0"/>

  <!-- ==================== ROOM SHELL ==================== -->
  <box pos="0 500 -5"  size="1200 1000 10" material="wood_oak" castShadow="0" sanityFloor="1"/>
  <box pos="0 500 425" size="1200 1000 12" material="wood_dark" castShadow="1"/>

  <wall pos="0 1000 0"    length="1200" height="420" thickness="24" material="plaster"/>
  <wall pos="-600 500 0"  rot="0 0 90" length="1000" height="420" thickness="24" material="plaster"/>
  <wall pos=" 600 500 0"  rot="0 0 90" length="1000" height="420" thickness="24" material="plaster"/>
  <wall pos="0 0 0"       length="1200" height="420" thickness="24" material="plaster" renderable="0" castShadow="0"/>

  <!-- ==================== ARCHITECTURAL RAFTERS ==================== -->
  <box pos="0 300 380" size="1200 30 40" material="wood_dark"/>
  <box pos="0 700 380" size="1200 30 40" material="wood_dark"/>

  <!-- ==================== SEMANTIC BLOCKOUT MASSES ==================== -->

  <!-- 1. CARDBOARD BOX "BROKEN - FOR REPAIR" (NW Corner) -->
  <box pos="-380 780 40" size="140 120 80" material="cardboard"/>

  <!-- 2. STACKED OLD WOODEN CRATES (East wall) -->
  <box pos="420 680 50" size="160 140 100" material="wood_dark"/>
  <box pos="400 480 35" size="120 120 70"  material="wood_oak"/>

  <!-- 3. LOFT LADDER OPENING (SW Floor opening) -->
  <box pos="-420 280 -10" size="120 120 10" material="wood_dark"/>

  <!-- ==================== NAMED INTERACTION ANCHORS ==================== -->
  <group name="REPAIR-BOX" pos="-380 780 40"/>

</scene>
