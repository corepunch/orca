<?xml version="1.0"?>
<!-- BLOCKOUT — Wondertown: Tolliver's Toy Workshop (Main Floor)
     X=east/west (-600 to 600, width=1200cm)
     Y=north/south (0 to 1000, depth=1000cm)
     Z=up (Floor Z=0, Ceiling Z=540cm)
     South wall Y=0   North wall Y=1000
     West wall X=-600 East wall X=600 -->
<scene ambient="0.06 0.08 0.10" background="midnight">

  <!-- ==================== PRODUCTION CAMERAS ==================== -->
  <!-- 1. ESTABLISHING: High SW corner looking diagonally across workshop.
       Height=380cm (70% of 540cm), pitch=24 deg down, FOV=68 deg.
       Shows North & East walls, heavy workbench, ladder, and pet door.
       Lower-right floor is text-safe negative space. -->
  <camera name="workshop-floor" comment="High SW corner diagonal establishing view of workshop floor"
          pos="-520 90 380" look="-40 680 90" fov="70"/>

  <!-- Object focus cameras use lowercased ZIL object names. -->
  <camera name="key-hook" comment="Close inspection of empty brass key hook on west wall"
          pos="-450 180 300" look="-580 180 320" fov="52"/>
  <camera name="workbench" comment="Medium view across Tolliver's workbench and its stacked projects"
          pos="180 230 230" look="-380 480 100" fov="58"/>
  <camera name="oil-can" comment="Low close view beneath the workbench toward the copper oil can"
          pos="-400 480 38" look="-450 360 18" fov="38"/>
  <camera name="sawdust" comment="Low raking view across the sawdust-covered floorboards"
          pos="250 180 85" look="-40 510 5" fov="58"/>
  <camera name="pet-door" comment="Low view toward the moonlit pet door in the north wall"
          pos="360 650 105" look="100 990 50" fov="52"/>
        <camera name="sweep-broom" comment="Low focus on Pip's broom leaning against the west wall"
          pos="-180 100 130" look="-574 250 90" fov="48"/>
  <camera name="clock-face" comment="Upward inspection of the old cuckoo clock on the west wall"
          pos="-300 480 290" look="-580 480 360" fov="46"/>
  <camera name="key-string" comment="Tight view of the frayed string hanging from the key hook"
          pos="-455 180 300" look="-580 180 292" fov="42"/>
  <camera name="loft-ladder" comment="Frontal focus on the ladder mounted to the south side of the storage loft"
          pos="-180 360 250" look="-410 700 240" fov="56"/>
  <camera name="ladder-mech" comment="Close inspection of the rusty ladder lifting mechanism"
          pos="-350 650 230" look="-576 680 220" fov="46"/>

  <!-- ==================== MATERIALS ==================== -->
  <material id="wood_dark"   color="0.35 0.22 0.14" shininess="20"/>
  <material id="wood_oak"    color="0.55 0.38 0.22" shininess="12"/>
  <material id="wallpaper"   color="0.28 0.38 0.34" shininess="4"/>
  <material id="stone"       color="0.42 0.40 0.38" shininess="8"/>
  <material id="floor"       color="0.30 0.25 0.20" shininess="10"/>
  <material id="brass"       color="0.88 0.75 0.32" shininess="36"/>

  <!-- ==================== MOTIVATED LIGHTING ==================== -->
  <!-- 1. Cool pale moonlight streaming through pet door & north transom window -->
  <light pos="100 1020 120" color="0.40 0.60 0.95" intensity="2.4" radius="450" castShadows="1"/>

  <!-- 2. Warm hanging gas work lamp over central workbench -->
  <light pos="-320 480 320" color="1.0 0.85 0.55" intensity="2.8" radius="480" castShadows="1"/>

  <!-- 3. East archway spill from tool bench area -->
  <light pos="540 280 220" color="0.95 0.75 0.40" intensity="1.8" radius="380" castShadows="0"/>

  <!-- ==================== ROOM SHELL ==================== -->
  <!-- Floor & Ceiling (1200cm wide × 1000cm deep × 540cm high) -->
  <box pos="0 500 -5"  size="1200 1000 10" material="floor" castShadow="0" sanityFloor="1"/>
  <box pos="0 500 545" size="1200 1000 12" material="wood_dark" castShadow="1"/>

  <!-- North, West, East, South Walls -->
  <wall pos="0 1000 0"    length="1200" height="540" thickness="24" material="wallpaper"/>
  <wall pos="-600 500 0"  rot="0 0 90" length="1000" height="540" thickness="24" material="wallpaper"/>
  <wall pos=" 600 500 0"  rot="0 0 90" length="1000" height="540" thickness="24" material="wallpaper"/>
  <wall pos="0 0 0"       length="1200" height="540" thickness="24" material="wallpaper" renderable="0" castShadow="0"/>

  <!-- Openings:
       East wall: Archway to tool bench
       North wall: Small pet door for alley exit -->
  <bool-negative-arch pos="600 280 160" rot="0 0 90" width="180" height="300" depth="50"/>
  <bool-negative-arch pos="100 1000 50" width="90" height="100" depth="50"/>

  <!-- ==================== SEMANTIC BLOCKOUT MASSES ==================== -->

  <!-- 1. TOLLIVER'S HEAVY OAK WORKBENCH (Flanking West wall) -->
        <group name="WORKBENCH" pos="-380 480 100">
                <box pos="0 0 -10" size="240 400 20" material="wood_oak"/>
                <box pos="-90 -160 -60" size="36 36 80" material="wood_oak"/>
                <box pos="90 -160 -60" size="36 36 80" material="wood_oak"/>
                <box pos="-90 160 -60" size="36 36 80" material="wood_oak"/>
                <box pos="90 160 -60" size="36 36 80" material="wood_oak"/>
        </group>
  <!-- Workbench wooden stool for 9yo Pip -->
  <box pos="-220 320 25" size="50 50 50" material="wood_dark"/>
  <!-- Illustrated Repair Book on desk -->
  <box pos="-360 440 108" size="70 50 14" material="wood_dark"/>
  <!-- Small copper oil can under bench -->
        <box pos="-450 360 12" size="20 20 24" material="brass"/>
        <!-- Pip's broom leans 2 degrees toward the west wall with measured clearance. -->
        <group name="SWEEP-BROOM" pos="-574 250 90.2">
                <box rot="0 -2 0" size="12 12 180" material="wood_oak"/>
                <box pos="40 0 -82" size="70 24 16" material="wood_dark"/>
        </group>

        <!-- Broad sawdust patch: a readable floor-level story object, not loose debris -->
        <box pos="-40 510 2" size="260 190 4" material="wood_oak" castShadow="0"/>

  <!-- 2. STORAGE LOFT MEZZANINE & FOLDING LADDER (NW Corner) -->
  <box pos="-440 850 420" size="300 280 20" material="wood_dark"/>
  <!-- Support beam -->
  <box pos="-300 710 210" size="20 20 420" material="wood_dark"/>
  <!-- Folding ladder faces south on the loft fascia; rails extend above the deck as handholds. -->
        <box pos="-432 698 240" size="12 12 480" material="wood_oak"/>
        <box pos="-388 698 240" size="12 12 480" material="wood_oak"/>
        <box pos="-410 698 35"  size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 70"  size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 105" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 140" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 175" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 210" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 245" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 280" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 315" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 350" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 385" size="56 14 10" material="wood_oak"/>
        <box pos="-410 698 420" size="56 14 10" material="wood_oak"/>
  <!-- Rusty lifting winch mechanism on wall -->
  <box pos="-576 680 220" size="24 30 40" material="stone"/>

  <!-- 3. WALL CLOCK & EMPTY BRASS KEY HOOK (West Wall, Foreground) -->
  <box pos="-585 180 320" size="10 30 50" material="brass"/>
        <box pos="-582 180 286" size="6 6 46" material="wood_oak"/>
  <box pos="-580 480 360" size="20 80 120" material="wood_dark"/>

  <!-- 4. TOOL CRATES & SWEEP BROOM (East Wall near archway) -->
  <box pos="500 580 40" size="140 120 80" material="wood_oak"/>
  <box pos="480 720 30" size="100 100 60" material="wood_dark"/>

  <!-- ==================== NAMED INTERACTION ANCHORS ==================== -->
  <group name="KEY-HOOK"   pos="-585 180 320"/>
        <group name="KEY-STRING" pos="-582 180 286"/>
        <group name="OIL-CAN"    pos="-450 360  12"/>
        <group name="SAWDUST"    pos="-40  510   2"/>
  <group name="PET-DOOR"   pos="100  990  50"/>
        <group name="LOFT-LADDER" pos="-410 698 210"/>
        <group name="LADDER-MECH" pos="-576 680 220"/>
  <group name="CLOCK-FACE" pos="-580 480 360"/>

</scene>
