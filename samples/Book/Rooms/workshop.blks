<?xml version="1.0"?>
<!-- BLOCKOUT — X=east  Y=north(depth)  Z=up
     South wall Y=0   North wall Y=1000
     Floor Z=0        Ceiling Z=640
     West wall X=-600  East wall X=600  -->
<scene ambient="0.55 0.58 0.60" background="midnight">

  <camera name="WorkshopEstablishing" comment="High front-left corner; lower-right floor is text-safe"
          pos="-540 80 420" look="85 735 105" fov="70"/>

  <material id="plaster"  color="0.38 0.52 0.50" shininess="3"/>
  <material id="wood"     color="0.55 0.30 0.12" shininess="16"/>
  <material id="floor"    color="0.18 0.20 0.22" shininess="4"/>

  <!-- blockout lighting -->
  <sun dir="0.4 0.5 -0.9" color="1.0 0.95 0.85" intensity="1.1" castShadows="1"/>
  <light pos="-400 200 500" color="0.6 0.7 0.8" intensity="2.5" radius="1400" castShadows="0"/>
  <light pos="300 800 400"  color="0.7 0.6 0.5" intensity="1.8" radius="1200" castShadows="0"/>

  <!-- room shell: 1200cm wide (X) × 1000cm deep (Y) × 640cm tall (Z) -->
  <box pos="0 500 -5"  size="1200 1000 10"  material="floor" castShadow="0" sanityFloor="1"/>
  <box pos="0 500 650" size="1200 1000 12"  material="wood"  castShadow="0"/>

  <wall pos="0 1000 0" length="1200" height="640" thickness="24" material="plaster"/>
  <bool-negative-arch pos="-170 1000 230" width="240" height="460" depth="50"/>
  <wall pos="-600 500 0"  rot="0 0 90" length="1000" height="640" thickness="24" material="plaster"/>
  <wall pos=" 600 500 0"  rot="0 0 90" length="1000" height="640" thickness="24" material="plaster"/>
  <wall pos="0 0 0"       length="1200" height="640" thickness="24" material="plaster" renderable="0" castShadow="0"/>

  <!-- workbench — south wall, east-west, strong foreground element -->
  <box pos="-200 100 52" size="400 120 104" material="wood"/>

  <!-- tool counter — north-east, against east wall -->
  <box pos="430 720 46"  size="200 90 92"  material="wood"/>

  <!-- crate stack — mid-east -->
  <box pos="300 390 70"  size="100 100 140" material="wood"/>

  <!-- loft platform — north-west corner, high -->
  <box pos="-490 940 500" size="180 100 18" material="wood"/>

  <!-- window mass — east wall, rear -->
  <box pos="588 820 280" size="24 200 160" material="plaster"/>

</scene>
