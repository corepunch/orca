<?xml version="1.0"?>
<!-- BLOCKOUT — establishing shot masses only, no detail -->
<scene ambient="0.55 0.58 0.60" background="midnight">

  <camera name="WorkshopEstablishing" comment="High front-left corner; lower-right floor is text-safe" pos="-540 420 -80" look="85 105 -735" fov="70"/>
  <camera name="LayoutPlan" comment="Top-down geography reference" pos="0 620 -500" look="0 0 -500" fov="92"/>

  <material id="plaster"  color="0.38 0.52 0.50" shininess="3"/>
  <material id="wood"     color="0.55 0.30 0.12" shininess="16"/>
  <material id="floor"    color="0.18 0.20 0.22" shininess="4"/>

  <!-- blockout lighting: bright enough to read every surface -->
  <sun dir="0.4 -0.9 -0.5" color="1.0 0.95 0.85" intensity="1.1" castShadows="1"/>
  <light pos="-400 500 -200" color="0.6 0.7 0.8" intensity="2.5" radius="1400" castShadows="0"/>
  <light pos="300 400 -800" color="0.7 0.6 0.5" intensity="1.8" radius="1200" castShadows="0"/>

  <!-- room shell: 1200 × 640 × 1000 cm -->
  <box pos="0   -5  -500" size="1200 10   1000" material="floor"  castShadow="0" sanityFloor="1"/>
  <box pos="0  650  -500" size="1200 12   1000" material="wood"   castShadow="0"/>
  <wall pos="0    0 -1000" length="1200" height="640" thickness="24" material="plaster"/>
  <!-- roman arch: bool-negative-arch cuts the arch void; center at world x=-170, sill=0, total h=460 -->
  <bool-negative-arch pos="-170 230 -1000" width="240" height="460" depth="50"/>
  <wall pos="-600  0  -500" rot="0 90 0" length="1000" height="640" thickness="24" material="plaster"/>
  <wall pos=" 600  0  -500" rot="0 90 0" length="1000" height="640" thickness="24" material="plaster"/>
  <wall pos="0    0     0" length="1200" height="640" thickness="24" material="plaster" renderable="0" castShadow="0"/>

  <!-- workbench — along left wall, long axis in Z; runs from foreground into mid-depth -->
  <box pos="-545 52 -430" size="80 104 560" material="wood"/>

  <!-- tool counter — mid-ground right -->
  <box pos="430 46 -630" size="200 92 90" material="wood"/>

  <!-- crate stack — mid right, breaks up the floor -->
  <box pos="300 70 -390" size="100 140 100" material="wood"/>

  <!-- loft platform — back-left corner, compact so it doesn't band across the frame -->
  <box pos="-490 500 -940" size="180 18 100" material="wood"/>

  <!-- window mass — right wall, mid-height rear; separates the back-right corner -->
  <box pos="588 280 -820" size="24 160 200" material="plaster"/>

</scene>
