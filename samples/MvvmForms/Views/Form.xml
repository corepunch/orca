<Screen Name="ProfileForm" Width="390" Height="844" ResizeMode="CanResize"
        ClearColor="$background" Controller="MvvmForms/Scripts/Form">
  <StackView Name="DraftForm" Padding="24" Spacing="12" Overflow="hidden scroll"
             Foreground="$foreground" DataContextSource="MvvmForms/Models/Profile:.">
    <TextBlock FontSize="30" FontWeight="Bold" Text="Your profile"/>
    <TextBlock FontSize="15" Foreground="$muted" Text="Changes stay in this draft until you save."/>
    <TextBlock MarginTop="16" Text="Display name"/>
    <Input Name="DisplayName" Height="48" Text="{Binding DataContext/DisplayName, Mode=TwoWay}"/>
    <TextBlock Text="Email address"/>
    <Input Name="Email" Type="Email" Height="48" Text="{Binding DataContext/Email, Mode=TwoWay}"/>
    <Grid Columns="32px 1fr" Height="48" Spacing="12">
      <Input Name="OptIn" Type="Checkbox" Checked="{Binding DataContext/OptIn, Mode=TwoWay}"/>
      <TextBlock Text="Send me updates" TextVerticalAlignment="Center"/>
    </Grid>
    <TextBlock MarginTop="12" Foreground="$muted" Text="Preview"/>
    <TextBlock Name="Preview" FontSize="20" Text="{Binding DataContext/DisplayName}"/>
    <Grid Columns="1fr 1fr" Height="48" Spacing="12" MarginTop="12">
      <Button Name="Save" Text="Save" Background="$accent" Foreground="#ffffff" Click="Save"/>
      <Button Name="Cancel" Text="Discard changes" Click="Cancel"/>
    </Grid>
    <TextBlock Name="Status" MarginTop="12" Text="{Binding DataContext/Status}"/>
  </StackView>
</Screen>
