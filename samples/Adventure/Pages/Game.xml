<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Page SYSTEM "https://corepunch.github.io/orca/schemas/orca.dtd">
<Page Name="GamePage">
	<Grid Name="Game" Rows="84px 1fr" class="page">
		<StackView Name="GameHeader" class="header">
			<TextBlock Name="GameBack" class="header-subtitle" Text="&#x2190; All games"
				LeftButtonUp="{NavigationHost.Pop}"/>
			<TextBlock Name="GameHeaderTitle" class="header-title" Text="{Binding DataContext/Title}"/>
		</StackView>
		<StackView Name="GameContent" class="page-content">
			<ImageView Name="GameCover" class="game-cover" Source="{Binding DataContext/Cover}" Stretch="UniformToFill"/>
			<TextBlock Name="GameTitle" class="game-title" Text="{Binding DataContext/Title}"/>
			<TextBlock Name="GameDescription" class="game-description" Text="{Binding DataContext/Description}"/>
		</StackView>
	</Grid>
</Page>
