<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Page SYSTEM "https://corepunch.github.io/orca/schemas/orca.dtd">
<Page Name="PlayPage" Controller="Adventure/Scripts/Play">
	<Grid Name="Play" Rows="84px 1fr 96px" class="page">
		<LayerPrefabPlaceholder Name="PlayHeader" 
			PlaceholderTemplate="Adventure/Prefabs/NavigationBar" 
			Page.Title="Play"/>
		<ListBox Name="Transcript" class="transcript"
			ItemsSource="Adventure/DataSources/Transcript:Entries"
			ItemTemplate="Adventure/Prefabs/Message"/>
		<Node2D Name="CommandBar" class="command-bar">
			<Input Name="CommandInput" class="command-input" PlaceholderText="Enter command..."/>
		</Node2D>
	</Grid>
</Page>
