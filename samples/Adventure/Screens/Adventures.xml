<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Screen SYSTEM "https://corepunch.github.io/orca/schemas/orca.dtd">
<Screen Name="Adventures" Width="400" Height="800" ClearColor="$background" StyleSheet="Adventure/Styles/app.css">
	<Grid Rows="84px 1fr 96px">
		<StackView Name="Header" class="header">
			<VectorView Name="BackButton" class="header-icon" Source="Adventure/Icons/back.svg"
				Visible="{Binding ../../Navigation/CanGoBack}" Stretch="Uniform"
				LeftButtonUp="{NavigationHost.Pop Target='../../Navigation'}"/>
			<TextBlock Name="HeaderTitle" class="header-title" Text="{Binding ../../Navigation/CurrentPageTitle}"/>
		</StackView>
		<NavigationHost Name="Navigation">
			<Page Name="RootPage" Title="Chronicle">
				<PageHost Name="Content" class="content" ActivePage="{Binding ../../../Footer/SelectedValue}">
					<Page Name="games" Title="Adventures" Source="Adventure/Pages/GameList.xml"/>
					<Page Name="library" Title="Library" Source="Adventure/Pages/Library.xml"/>
					<Page Name="settings" Title="Settings" Source="Adventure/Pages/Settings.xml"/>
				</PageHost>
			</Page>
		</NavigationHost>
		<ListBox Name="Footer" class="footer"
			ItemsSource="Adventure/DataSources/Tabs"
			ItemTemplate="Adventure/Prefabs/TabItem"
			ValueProperty="Key"
			SelectedValue="games"/>
	</Grid>
</Screen>
